@page "/play/{movieId:int}"
@inject IMovieRepository MovieRepo
@inject IPlayerService PlayerService
@inject IPlayHistoryService PlayHistoryService
@inject NavigationManager NavigationManager
@inject IServiceProvider ServiceProvider
@inject ILoggerService Logger
@inject MovieAgent.Infrastructure.Services.ISubtitleService SubtitleService

<PageTitle>@(_movie?.Title ?? "播放")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Style="padding: 16px;">
    @if (_movie == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 24px; border-radius: 12px;">
            <MudStack Spacing="4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="NavigateBack" StartIcon="@Icons.Material.Filled.ArrowBack">
                        返回
                    </MudButton>
                    <MudText Typo="Typo.h5" Style="color: #E94560;">@_movie.Title</MudText>
                    <MudText Style="color: gray;">@_playStatus</MudText>
                </MudStack>

                <div style="background: #000; width: 100%; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; position: relative;">
                    @if (_isPlaying)
                    {
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #E0E0E0; text-align: center; padding: 20px;">
                            <MudIcon Icon="@Icons.Material.Filled.Tv" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Style="color: #E94560; margin-top: 16px;">@_playStatus</MudText>
                            <MudText Typo="Typo.body2" Style="color: #888; margin-top: 8px;">视频正在应用内播放器中播放 - 请查看上方的播放窗口</MudText>
                        </div>
                    }
                    else
                    {
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #E0E0E0; text-align: center; padding: 20px;">
                            <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Style="color: #E0E0E0; margin-top: 16px;">@_movie?.Title</MudText>
                            <MudText Typo="Typo.body2" Style="color: #888; margin-top: 8px;">点击"播放"按钮开始观看</MudText>
                        </div>
                    }
                </div>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TogglePlay" Size="Size.Large"
                               StartIcon="@(_isPlaying ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                               Style="background:#E94560;">
                        @(_isPlaying ? "暂停" : "播放")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="StopPlayback" StartIcon="@Icons.Material.Filled.Stop">
                        停止
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PlayExternal" StartIcon="@Icons.Material.Filled.OpenInNew">
                        外置播放器
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="ShowSubtitleDialog" StartIcon="@Icons.Material.Filled.Subtitles">
                        字幕下载
                    </MudButton>
                </MudStack>

                <MudDivider Style="margin: 16px 0;" />

                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudImage Src="@GetPosterUrl(_movie)" Height="300" ObjectFit="ObjectFit.Cover" Style="border-radius: 8px;" />
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudText Typo="Typo.h6" Style="color: #E94560;">@_movie.Title</MudText>
                        <MudChipSet T="string" Style="margin: 12px 0;">
                            @if (_movie.ReleaseYear.HasValue)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_movie.ReleaseYear</MudChip>
                            }
                            @if (!string.IsNullOrEmpty(_movie.Resolution))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_movie.Resolution</MudChip>
                            }
                            @if (_movie.Rating.HasValue)
                            {
                                <MudChip T="string" Size="Size.Small" Style="background:#FFD700;">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> @_movie.Rating.Value.ToString("0.0")
                                </MudChip>
                            }
                        </MudChipSet>
                        <MudText Typo="Typo.body1" Style="color: #E0E0E0; line-height: 1.8;">
                            @(_movie.Overview ?? "暂无简介")
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color: gray; margin-top: 8px;">@_movie.FilePath</MudText>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

<MudDialog @bind-Visible="_subtitleDialogVisible">
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">字幕下载</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SearchSubtitles">
                    <MudIcon Icon="@Icons.Material.Filled.Search" />
                </MudButton>
            </MudStack>
            
            <MudTextField T="string" @bind-Value="_subtitleQuery" Label="搜索关键词" 
                         Placeholder="输入电影名称搜索字幕" />
            
            <MudSelect T="string" @bind-Value="_subtitleLanguage" Label="语言">
                <MudSelectItem T="string" Value="@("zh")">中文</MudSelectItem>
                <MudSelectItem T="string" Value="@("en")">英文</MudSelectItem>
                <MudSelectItem T="string" Value="@("zh-en")">中英双语</MudSelectItem>
            </MudSelect>
            
            @if (_isSearching)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            }
            else if (_subtitles.Any())
            {
                <MudList T="MovieAgent.Infrastructure.Services.SubtitleResult">
                    @foreach (var subtitle in _subtitles)
                    {
                        <MudListItem T="MovieAgent.Infrastructure.Services.SubtitleResult">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;">
                                <div>
                                    <MudText Typo="Typo.body1">@subtitle.Title</MudText>
                                    <MudText Typo="Typo.caption" Style="color: gray;">
                                        语言: @subtitle.Language | 评分: @subtitle.Rating
                                        @if (subtitle.IsHearingImpaired)
                                        {
                                            <span style="margin-left: 8px;">(听力障碍版)</span>
                                        }
                                    </MudText>
                                </div>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" 
                                           OnClick="() => DownloadAndSaveSubtitle(subtitle)"
                                           Style="background:#E94560;">
                                    下载
                                </MudButton>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2" Style="color: gray; text-align: center; padding: 20px;">
                    暂无字幕，请输入关键词搜索
                </MudText>
            }
            
            @if (!string.IsNullOrEmpty(_subtitleMessage))
            {
                <MudText Typo="Typo.caption" Style="color: #E94560;">@_subtitleMessage</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseSubtitleDialog">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int movieId { get; set; }
    private Movie? _movie;
    private bool _isPlaying;
    private bool _isPaused;
    private string _playStatus = "准备就绪";
    private bool _disposed;
    
    private bool _subtitleDialogVisible = false;
    private string _subtitleQuery = string.Empty;
    private string _subtitleLanguage = "zh";
    private bool _isSearching = false;
    private List<MovieAgent.Infrastructure.Services.SubtitleResult> _subtitles = new();
    private string _subtitleMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _movie = await MovieRepo.GetByIdAsync(movieId);
        if (_movie == null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }
        _subtitleQuery = _movie.Title;
    }

    private async Task TogglePlay()
    {
        if (_movie == null) return;

        if (!_isPlaying && !_isPaused)
        {
            await StartPlayback();
        }
        else if (_isPlaying)
        {
            PlayerService.Pause();
            _isPlaying = false;
            _isPaused = true;
            _playStatus = "已暂停";
        }
        else if (_isPaused)
        {
            PlayerService.Resume();
            _isPlaying = true;
            _isPaused = false;
            _playStatus = "正在播放";
        }
    }

    private async Task StartPlayback()
    {
        if (_movie == null) return;

        try
        {
            _playStatus = "正在加载...";
            StateHasChanged();

            // 请求播放 - 通知MainWindow显示视频overlay并开始播放
            Logger.Debug($"[Player.razor] 调用 RequestPlayback: {_movie.FilePath}");
            PlayerService.RequestPlayback(_movie.FilePath);

            _isPlaying = true;
            _isPaused = false;
            _playStatus = "正在播放";
            
            _movie.IsWatched = true;
            _movie.WatchedAt = DateTime.UtcNow;
            await MovieRepo.UpdateAsync(_movie);
            
            await PlayHistoryService.AddPlayHistoryAsync(
                movieId: _movie.Id,
                duration: _movie.Runtime,
                completed: false
            );
            
            Logger.Debug($"[Player] 播放历史已记录: {_movie.Title}");
        }
        catch (Exception ex)
        {
            Logger.Error(ex, $"[Player] Play failed: {ex.Message}");
            var dialog = ServiceProvider.GetRequiredService<IDialogService>();
            await dialog.ShowMessageBoxAsync("播放失败", $"播放失败: {ex.Message}\n\n文件路径: {_movie.FilePath}", yesText: "确定");
            _playStatus = "播放失败";
            _isPlaying = false;
            _isPaused = false;
        }
    }

    private async Task StopPlayback()
    {
        await PlayerService.StopAsync();
        _isPlaying = false;
        _isPaused = false;
        _playStatus = "已停止";
        
        if (_movie != null)
        {
            try
            {
                var currentProgress = (int)PlayerService.Position.TotalSeconds;
                await PlayHistoryService.AddPlayHistoryAsync(
                    movieId: _movie.Id,
                    progress: currentProgress / 60,
                    duration: _movie.Runtime,
                    completed: _movie.Runtime.HasValue && currentProgress > (_movie.Runtime.Value * 60 * 0.9)
                );
                Logger.Debug($"[Player] 停止历史已记录，进度: {currentProgress}秒");
            }
            catch (Exception ex)
            {
                Logger.Debug($"[Player] 记录停止历史失败: {ex.Message}");
            }
        }
    }

    private async Task PlayExternal()
    {
        if (_movie == null) return;
        try
        {
            // 使用系统默认播放器打开文件
            var process = new System.Diagnostics.Process();
            process.StartInfo.FileName = _movie.FilePath;
            process.StartInfo.UseShellExecute = true;
            process.Start();

            _playStatus = "已启动外置播放器";
            Logger.Debug($"[Player] 已使用外置播放器播放: {_movie.FilePath}");
        }
        catch (Exception ex)
        {
            Logger.Error(ex, $"[Player] 外置播放器启动失败: {_movie.FilePath}");
            var dialog = ServiceProvider.GetRequiredService<IDialogService>();
            await dialog.ShowMessageBoxAsync("启动失败", $"启动失败: {ex.Message}", yesText: "确定");
        }
    }

    private async void NavigateBack()
    {
        await StopPlayback();
        NavigationManager.NavigateTo($"/movie/{movieId}");
    }

    private string GetPosterUrl(Movie movie)
    {
        if (!string.IsNullOrWhiteSpace(movie.PosterPath))
            return $"https://image.tmdb.org/t/p/w500{movie.PosterPath}";
        return "images/placeholder-poster.png";
    }

    private void ShowSubtitleDialog()
    {
        _subtitleDialogVisible = true;
    }

    private void CloseSubtitleDialog()
    {
        _subtitleDialogVisible = false;
        _subtitleMessage = string.Empty;
    }

    private async Task SearchSubtitles()
    {
        if (string.IsNullOrWhiteSpace(_subtitleQuery))
        {
            _subtitleMessage = "请输入搜索关键词";
            return;
        }

        _isSearching = true;
        _subtitleMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

        try
        {
            _subtitles = await SubtitleService.SearchSubtitlesAsync(_subtitleQuery, _subtitleLanguage);
            
            if (!_subtitles.Any())
            {
                _subtitleMessage = "未找到匹配的字幕";
            }
        }
        catch (Exception ex)
        {
            _subtitleMessage = $"搜索失败: {ex.Message}";
            Logger.Error(ex, "[Player] 字幕搜索失败");
        }
        finally
        {
            _isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DownloadAndSaveSubtitle(MovieAgent.Infrastructure.Services.SubtitleResult subtitle)
    {
        try
        {
            _subtitleMessage = "正在下载...";
            await InvokeAsync(StateHasChanged);

            var data = await SubtitleService.DownloadSubtitleAsync(subtitle.DownloadUrl);
            if (data == null)
            {
                _subtitleMessage = "下载失败";
                return;
            }

            var filePath = await SubtitleService.SaveSubtitleAsync(movieId, data, subtitle.Extension);
            
            if (!string.IsNullOrEmpty(filePath))
            {
                _subtitleMessage = $"字幕已保存: {Path.GetFileName(filePath)}";
                Logger.Debug($"[Player] 字幕已保存: {filePath}");
            }
            else
            {
                _subtitleMessage = "保存失败";
            }
        }
        catch (Exception ex)
        {
            _subtitleMessage = $"下载失败: {ex.Message}";
            Logger.Error(ex, "[Player] 字幕下载失败");
        }
        
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;

        if (_isPlaying || _isPaused)
        {
            try { PlayerService.StopAsync().ConfigureAwait(false); }
            catch { }
        }
    }
}