@page "/movie/{Id}"
@using MovieAgent.Components.Controls
@inject IMovieRepository MovieRepo
@inject MovieAgent.Infrastructure.Services.ITagService TagService
@inject NavigationManager NavigationManager
@inject ILoggerService Logger
@inject MovieAgent.Infrastructure.Services.IDoubanService DoubanService
@inject MovieAgent.Infrastructure.Services.IMovieReviewService ReviewService
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider

<PageTitle>@(_movie?.Title ?? "电影详情")</PageTitle>

@if (_isLoading || _movie == null)
{
    <div style="display: flex; justify-content: center; align-items: center; min-height: 300px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <!-- 页面标题 -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="position: relative; overflow: hidden;margin-bottom: 20px;">
        <MudText Typo="Typo.h4" Style="color: #E94560;">电影详情</MudText>
        <MudButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(async () => await GoBackAsync())">返回</MudButton>
    </MudStack>
    <!-- 背景图（BackdropPath）- 右上对齐，半透明 -->
    @if (!string.IsNullOrWhiteSpace(_movie.BackdropPath))
    {
        <div style="position: absolute; top: 0; right: 0; width: 100%; height: 100%; opacity: 0.2;pointer-events: none">
            <img src="https://image.tmdb.org/t/p/w1280/@_movie.BackdropPath"
                 alt="@_movie.Title"
                 style="width: 100%; height: 100%; object-fit: cover;border-radius:8px;" />
        </div>
    }

    <MudGrid>
        <MudItem xs="12" md="3">
            <MudImage Src="@GetPosterUrl(_movie)" Height="450" ObjectFit="ObjectFit.Cover" Elevation="8" Style="border-radius:10px;" /> 
   
        </MudItem>
        <MudItem xs="12" md="8" Style="position: relative;padding:8px;">
        
            <!-- 内容区域 -->
            <div style="position: relative; z-index: 1;">
                <!-- 标题区域 -->
                <MudText Typo="Typo.h3" Style="color: #E94560; font-weight: bold;">@_movie.Title</MudText>
            @if (!string.IsNullOrEmpty(_movie.OriginalTitle) && _movie.OriginalTitle != _movie.Title)
            {
                <MudText Typo="Typo.subtitle1" Style="color: gray; margin-bottom: 12px;">@_movie.OriginalTitle</MudText>
            }

            <!-- 基本信息标签 -->
            <MudChipSet T="string" Style="margin: 12px 0;">
                @if (_movie.ReleaseYear.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_movie.ReleaseYear</MudChip>
                }
                @if (!string.IsNullOrEmpty(_movie.Resolution))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_movie.Resolution</MudChip>
                }
                @if (_movie.Rating.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Style="background:#FFD700;">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                        @_movie.Rating.Value.ToString("0.0")
                        @if (!string.IsNullOrEmpty(_ratingSource))
                        {
                            <span style="margin-left: 4px; font-size: 10px;">(@_ratingSource)</span>
                        }
                    </MudChip>
                }
                @if (_movie.Runtime.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark">@(_movie.Runtime)分钟</MudChip>
                }
                @if (!string.IsNullOrEmpty(_movie.VideoCodec))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark">视频: @_movie.VideoCodec</MudChip>
                }
                @if (!string.IsNullOrEmpty(_movie.AudioCodec))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark">音频: @_movie.AudioCodec</MudChip>
                }
                @if (!string.IsNullOrEmpty(_movie.HdrType))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Style="background: #4CAF50;">@_movie.HdrType</MudChip>
                }
            </MudChipSet>

            <!-- 类型标签 -->
            @if (!string.IsNullOrEmpty(_movie.Genres))
            {
                <MudChipSet T="string" Style="margin: 12px 0;">
                    @foreach (var genre in GetGenres())
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">@genre</MudChip>
                    }
                </MudChipSet>
            }

            <!-- 详细信息 -->
            <div style="margin: 16px 0;">
                <!-- 标语 -->
                @if (!string.IsNullOrEmpty(_movie.Tagline))
                {
                    <MudText Typo="Typo.body2" Style="color: #E94560; font-style: italic; margin-bottom: 12px;">
                        "@_movie.Tagline"
                    </MudText>
                }

                <!-- 简介 -->
                @if (!string.IsNullOrEmpty(_movie.Overview))
                {
                    <MudText Typo="Typo.subtitle2" Style="color: #E94560; margin-bottom: 8px;">简介</MudText>
                    <MudText Typo="Typo.body1" Style="color: #E0E0E0; line-height: 1.8; margin-bottom: 16px;">
                        @_movie.Overview
                    </MudText>
                }

                <!-- 导演 -->
                @if (!string.IsNullOrEmpty(_movie.Director))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">导演:</span> 
                        @if (!string.IsNullOrEmpty(_movie.DirectorTmdbId))
                        {
@*                             <MudLink Href="@($"/person/{_movie.DirectorTmdbId}")" Style="color: #E94560;">@_movie.Director</MudLink>
 *@                                @RenderDirectorLinks(_movie.Director, _movie.DirectorTmdbId)

                        }
                        else
                        {
                            <span style="color: #E0E0E0;">@_movie.Director</span>
                        }
                    </MudText>
                }

                <!-- 编剧 -->
                @if (!string.IsNullOrEmpty(_movie.Writer))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">编剧:</span> @* <span style="color: #E0E0E0;">@_movie.Writer</span> *@
                            @RenderWriterLinks(_movie.Writer, _movie.WriterTmdbIds)

                    </MudText>
                }

                <!-- 主演 -->
                @if (!string.IsNullOrEmpty(_movie.Cast))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">主演:</span> 
                            @RenderCastLinks(_movie.Cast, _movie.CastTmdbIds)
                        </MudText>
                }

                <!-- 地区 -->
                @if (!string.IsNullOrEmpty(_movie.Country))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">地区:</span> <span style="color: #E0E0E0;">@_movie.Country</span>
                    </MudText>
                }

                <!-- 语言 -->
                @if (!string.IsNullOrEmpty(_movie.Language))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">语言:</span> <span style="color: #E0E0E0;">@_movie.Language</span>
                    </MudText>
                }

                <!-- 制片公司 -->
                @if (!string.IsNullOrEmpty(_movie.ProductionCompanies))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">制片公司:</span> 
                        @RenderCompanyLinks(_movie.ProductionCompanies, _movie.ProductionCompanyIds)
                    </MudText>
                }

                <!-- IMDB ID -->
                @if (!string.IsNullOrEmpty(_movie.ImdbId))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">IMDB:</span> 
                        <MudLink Href="@($"https://www.imdb.com/title/{_movie.ImdbId}")" Target="_blank" Style="color: #E94560;">
                            @_movie.ImdbId
                        </MudLink>
                    </MudText>
                }

                <!-- 所属系列 -->
                @if (!string.IsNullOrEmpty(_movie.BelongsToCollection))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">所属系列:</span> <span style="color: #E0E0E0;">@_movie.BelongsToCollection</span>
                    </MudText>
                }

                <!-- 官方网站 -->
                @if (!string.IsNullOrEmpty(_movie.Homepage))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">官网:</span> 
                        <MudLink Href="@_movie.Homepage" Target="_blank" Style="color: #E94560;">
                            访问官网
                        </MudLink>
                    </MudText>
                }

                <!-- 财务信息 -->
                @if (_movie.Budget.HasValue && _movie.Budget > 0)
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">制作预算:</span> <span style="color: #4CAF50;">$@_movie.Budget.Value.ToString("N0")</span>
                    </MudText>
                }

                @if (_movie.Revenue.HasValue && _movie.Revenue > 0)
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">票房收入:</span> <span style="color: #4CAF50;">$@_movie.Revenue.Value.ToString("N0")</span>
                    </MudText>
                }

                <!-- 投票和人气 -->
                @if (_movie.VoteCount.HasValue && _movie.VoteCount > 0)
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">投票数:</span> <span style="color: #E0E0E0;">@_movie.VoteCount.Value.ToString("N0")</span>
                    </MudText>
                }

                @if (_movie.Popularity.HasValue && _movie.Popularity > 0)
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">人气指数:</span> <span style="color: #E0E0E0;">@_movie.Popularity.Value.ToString("F0")</span>
                    </MudText>
                }

                <!-- 关键词 -->
                @if (!string.IsNullOrEmpty(_movie.Keywords))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">关键词:</span> <span style="color: #ccc;">@GetKeywords()</span>
                    </MudText>
                }

                <!-- TMDB ID -->
                @if (!string.IsNullOrEmpty(_movie.TmdbId))
                {
                    <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                        <span style="color: #888;">TMDB ID:</span> <span style="color: #E0E0E0;">@_movie.TmdbId</span>
                    </MudText>
                }

                <!-- 文件信息 -->
                <MudText Typo="Typo.body2" Style="margin-bottom: 4px;">
                    <span style="color: #888;">文件大小:</span> <span style="color: #E0E0E0;">@FormatFileSize(_movie.FileSize)</span>
                </MudText>

                <!-- 文件路径 -->
                <MudText Typo="Typo.caption" Style="color: gray;">@_movie.FilePath</MudText>

                <!-- 状态信息 -->
                <MudStack Row="true" Spacing="4" Style="margin-top: 12px;">
                    <MudChip T="string" Size="Size.Small" Color="@(_movie.IsWatched ? Color.Success : Color.Warning)">
                        @(_movie.IsWatched ? "已观看" : "未观看")
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@(_movie.IsFavorite ? Color.Error : Color.Default)">
                        @(_movie.IsFavorite ? "已收藏" : "未收藏")
                    </MudChip>
                </MudStack>

                <!-- 时间信息 -->
                <MudStack Row="true" Spacing="6" Style="margin-top: 12px;">
                    <MudText Typo="Typo.caption" Style="color: gray;">
                        添加时间: @_movie.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </MudText>
                    @if (_movie.WatchedAt.HasValue)
                    {
                        <MudText Typo="Typo.caption" Style="color: gray;">
                            最后观看: @_movie.WatchedAt.Value.ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                    }
                </MudStack>
            </div>

            <!-- 标签管理 -->
                <div style="margin: 16px 0; padding: 12px; background: #2D2D44; border-radius: 8px;opacity: 0.8;">
                <MudText Typo="Typo.subtitle2" Style="color: #E94560; margin-bottom: 8px;">标签</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var tag in _tags)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" 
                                 OnClick="() => RemoveTag(tag)">
                            @tag
                        </MudChip>
                    }
                    @if (_tags.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color: gray;">暂无标签（点击标签可删除）</MudText>
                    }
                </MudStack>
                
                <div style="margin-top: 12px; display: flex; gap: 8px;">
                    <MudTextField T="string" @bind-Value="_newTag" Placeholder="输入标签" Adornment="Adornment.End" 
                                 AdornmentIcon="@Icons.Material.Filled.Add" />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" 
                               OnClick="AddNewTag">
                        添加
                    </MudButton>
                    <div style="min-width: 100px; display: inline-flex; align-items: center; justify-content: center;">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" 
                                   OnClick="GenerateTagsWithAI" Disabled="@_isGenerating">
                            @if (_isGenerating)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span style="margin-left: 4px;">生成中...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Park" Size="Size.Small" />
                                <span>AI生成</span>
                            }
                        </MudButton>
                    </div>
                </div>
            </div>

            <!-- 操作按钮 -->
            <MudStack Row="true" Style="margin-top: 24px;" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="PlayMovie" Style="background:#E94560;">播放</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           OnClick="ToggleWatched">
                    @(_movie.IsWatched ? "标为未看" : "标为已看")
                </MudButton>
                <MudIconButton Icon="@(_movie.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder)"
                               Color="Color.Error" OnClick="ToggleFavorite" />
                <MudRating SelectedValue="_userRating" Size="Size.Small" SelectedValueChanged="OnRatingChanged" Color="Color.Warning" />
            </MudStack>

            <!-- 评分同步 -->
          @*       <div style="margin-top: 16px; padding: 12px; background: #2D2D44; border-radius: 8px;opacity: 0.8;">
                <MudText Typo="Typo.subtitle2" Style="color: #E94560; margin-bottom: 8px;">评分同步</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField T="string" @bind-Value="_doubanId" Placeholder="豆瓣电影ID" Style="width: 180px;" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" 
                               OnClick="SearchDoubanRating" Disabled="@_isSearching">
                        @if (_isSearching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span style="margin-left: 4px;">搜索中...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                            <span>搜索豆瓣评分</span>
                        }
                    </MudButton>
                    @if (_doubanMovie != null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Style="background:#00BFFF;">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                            豆瓣 @_doubanMovie.Rating.Value.ToString("0.0")
                        </MudChip>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" 
                                   OnClick="SyncDoubanRating" Style="background:#00BFFF;">
                            <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                            <span>同步评分</span>
                        </MudButton>
                    }
                </MudStack>
                @if (!string.IsNullOrEmpty(_doubanMessage))
                {
                    <MudText Typo="Typo.caption" Style="color: #E94560; margin-top: 8px;">@_doubanMessage</MudText>
                }
            </div> *@

            <!-- 影评区域 -->
                <div style="margin-top: 16px; padding: 12px; background: #2D2D44; border-radius: 8px;opacity: 0.8;">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="margin-bottom: 12px;">
                    <MudText Typo="Typo.subtitle2" Style="color: #E94560;">我的影评</MudText>
                    @if (_myReview == null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" 
                                   OnClick="ShowReviewDialog" Style="background:#E94560;">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                            <span>写影评</span>
                        </MudButton>
                    }
                </MudStack>
                
                @if (_myReview != null)
                {
                    <MudPaper Elevation="0" Style="padding: 12px; background: #1A1A2E; border-radius: 8px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="margin-bottom: 8px;">
                            <MudRating ReadOnly="true" SelectedValue="_myReview.Rating" Size="Size.Small" Color="Color.Warning" />
                            <MudText Typo="Typo.caption" Style="color: #888;">
                                @_myReview.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                                           OnClick="() => ShowEditReviewDialog(_myReview)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteReview(_myReview)" />
                        </MudStack>
                        <MudText Typo="Typo.body2" Style="color: #E0E0E0; white-space: pre-wrap;">@_myReview.Content</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color: #888;">还没有写过影评，记录你的观影感受吧！</MudText>
                }
            </div>
            
            <!-- 闭合内容区域 -->
            </div>
        </MudItem>
    </MudGrid>
    
    <!-- 相似电影推荐 -->
    <SimilarMoviesPanel MovieId="@_localId" TopK="6" />
}

<!-- 影评编辑对话框 -->
<MudDialog @bind-Visible="_reviewDialogVisible">
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">@(_isEditingReview ? "编辑影评" : "写影评")</MudText>
            <MudRating @bind-SelectedValue="_reviewRating" Size="Size.Medium" Color="Color.Warning" />
            <MudTextField T="string" @bind-Value="_reviewContent" Label="影评内容" Variant="Variant.Outlined" 
                         Lines="6" Placeholder="写下你对这部电影的感受..." />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseReviewDialog">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveReview" Style="background:#E94560;">
            保存
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private int _localId;
    private Movie? _movie;
    private int _userRating;
    private List<string> _tags = new();
    private string _newTag = string.Empty;
    private bool _isGenerating = false;
    private bool _isLoading = false;

    private string _doubanId = string.Empty;
    private MovieAgent.Infrastructure.Services.DoubanMovieInfo? _doubanMovie;
    private bool _isSearching = false;
    private string _doubanMessage = string.Empty;
    private string _ratingSource = string.Empty;

    private List<MovieAgent.Core.Entities.MovieReview> _reviews = new();
    private MovieAgent.Core.Entities.MovieReview? _myReview;
    private bool _reviewDialogVisible = false;
    private bool _isEditingReview = false;
    private int _reviewRating = 5;
    private string _reviewContent = string.Empty;
    private int? _editingReviewId;

    protected override async Task OnInitializedAsync()
    {
        await LoadMovieAndTags();
        await LoadReviews();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadMovieAndTags();
        await LoadReviews();
    }

    private async Task LoadMovieAndTags()
    {
        _isLoading = true;
        _isGenerating = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (int.TryParse(Id, out var localId))
            {
                _movie = await MovieRepo.GetByIdAsync(localId);
                _localId = localId;
            }

            if (_movie == null)
            {
                _movie = await MovieRepo.GetByTmdbIdAsync(Id);
                if (_movie != null)
                {
                    _localId = _movie.Id;
                    Id = _movie.Id.ToString();
                }
                else

                {
                    var dialog = ServiceProvider.GetRequiredService<IDialogService>(); 
                     await dialog.ShowMessageBoxAsync("查询失败", $"本地库没有相关的电影", yesText: "确定"); 
                    return;
                }
            }
            if (_movie != null)
            {
                // 自动获取海报和媒体信息（如果数据库中没有）
                if (string.IsNullOrEmpty(_movie.PosterPath))
                {
                    // 先尝试从豆瓣获取
                    // var doubanInfo = await DoubanService.SearchMovieAsync(_movie.Title, _movie.ReleaseYear);
                    // if (doubanInfo != null)
                    // {
                    //     if (!string.IsNullOrEmpty(doubanInfo.Poster))
                    //         _movie.PosterPath = doubanInfo.Poster;
                    //     if (doubanInfo.Rating.HasValue)
                    //         _movie.Rating = doubanInfo.Rating.Value;
                    //     if (!string.IsNullOrEmpty(doubanInfo.Director))
                    //         _movie.Director = doubanInfo.Director;
                    //     if (!string.IsNullOrEmpty(doubanInfo.Genres))
                    //         _movie.Genres = doubanInfo.Genres;
                    //     if (!string.IsNullOrEmpty(doubanInfo.Country))
                    //         _movie.Country = doubanInfo.Country;
                    //     if (!string.IsNullOrEmpty(doubanInfo.Language))
                    //         _movie.Language = doubanInfo.Language;
                    //     if (!string.IsNullOrEmpty(doubanInfo.Summary))
                    //         _movie.Overview = doubanInfo.Summary;

                    //     await MovieRepo.UpdateAsync(_movie);
                    // }
                    // else
                    // {
                    //     // 如果豆瓣没有找到，尝试从本地目录获取
                    //     await MovieRepo.UpdatePosterFromDirectoryAsync(_movie);
                    //     await MovieRepo.UpdateMediaInfoFromDirectoryAsync(_movie);
                    //     _movie = await MovieRepo.GetByIdAsync(Id); // 重新加载
                    // }
                }

                _userRating = _movie?.UserRating ?? 0;
                _ratingSource = _movie?.TmdbId != null ? "TMDB" : string.Empty;
            }

            _tags = await TagService.GetTagsAsync(_localId);
            _newTag = string.Empty;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadReviews()
    {
        _reviews = await ReviewService.GetReviewsByMovieAsync(_localId);
        _myReview = _reviews.FirstOrDefault();
    }

    private async Task LoadTags()
    {
        _tags = await TagService.GetTagsAsync(_localId);
        _newTag = string.Empty;
    }

    private async Task AddNewTag()
    {
        if (string.IsNullOrWhiteSpace(_newTag)) return;

        await TagService.AddTagAsync(_localId, _newTag.Trim());
        await LoadTags();
    }

    private async Task RemoveTag(string tag)
    {
        await TagService.RemoveTagAsync(_localId, tag);
        await LoadTags();
    }

    private async Task GenerateTagsWithAI()
    {
        if (_movie == null) return;

        _isGenerating = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await TagService.AddAllAiTagsAsync(_localId);
            await LoadTags();
        }
        finally
        {
            _isGenerating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

