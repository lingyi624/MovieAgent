    private async Task ToggleWatched()
    {
        if (_movie == null) return;

        _movie.IsWatched = !_movie.IsWatched;
        _movie.WatchedAt = _movie.IsWatched ? DateTime.UtcNow : null;
        await MovieRepo.UpdateAsync(_movie);
    }

    private async Task ToggleFavorite()
    {
        if (_movie == null) return;

        _movie.IsFavorite = !_movie.IsFavorite;
        await MovieRepo.UpdateAsync(_movie);
    }

    private List<string> GetGenres()
    {
        try
        {
            if (string.IsNullOrEmpty(_movie?.Genres))
                return new List<string>();
            var genres = System.Text.Json.JsonSerializer.Deserialize<List<string>>(_movie.Genres);
            return genres ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    private string GetCompanies()
    {
        try
        {
            if (string.IsNullOrEmpty(_movie?.ProductionCompanies))
                return "";
            var companies = System.Text.Json.JsonSerializer.Deserialize<List<string>>(_movie.ProductionCompanies);
            if (companies != null && companies.Any())
                return string.Join("、", companies.Take(3));
            return _movie.ProductionCompanies;
        }
        catch
        {
            return _movie?.ProductionCompanies ?? "";
        }
    }

    private RenderFragment RenderCastLinks() => __builder =>
    {
        try
        {
            if (string.IsNullOrEmpty(_movie?.Cast))
                return;

            var castNames = _movie.Cast.Split(',').Select(n => n.Trim()).ToList();
            var castIds = new List<string?>();

            if (!string.IsNullOrEmpty(_movie.CastTmdbIds))
            {
                castIds = System.Text.Json.JsonSerializer.Deserialize<List<string>>(_movie.CastTmdbIds) ?? new List<string?>();
            }

            for (int i = 0; i < castNames.Count; i++)
            {
                if (i > 0)
                {
                    <span style="color: #888;">, </span>
                }
                var id = i < castIds.Count ? castIds[i] : null;
                if (!string.IsNullOrEmpty(id))
                {
                    <MudLink Href="@($"/person/{id}")" Style="color: #E94560;">@castNames[i >= castNames.Count ? castNames.Count -1:i]</MudLink>
                }
                else
                {
                    <span style="color: #E0E0E0;">@castNames[i]</span>
                }
            }
            
        }
        catch
        {
            <span style="color: #E0E0E0;">@_movie?.Cast</span>
        }
    };

    private RenderFragment RenderCompanyLinks() => __builder =>
    {
        try
        {
            if (string.IsNullOrEmpty(_movie?.ProductionCompanies))
                return;
            
            List<string> companyNames;
            try
            {
                companyNames = System.Text.Json.JsonSerializer.Deserialize<List<string>>(_movie.ProductionCompanies) ?? new List<string>();
            }
            catch
            {
                companyNames = _movie.ProductionCompanies.Split('、').Select(n => n.Trim()).ToList();
            }
            
            var companyIds = new List<string?>();
            
            if (!string.IsNullOrEmpty(_movie.ProductionCompanyIds))
            {
                companyIds = System.Text.Json.JsonSerializer.Deserialize<List<string>>(_movie.ProductionCompanyIds) ?? new List<string?>();
            }
            
            for (int i = 0; i < companyNames.Count; i++)
            {
                if (i > 0)
                {
                    <span style="color: #888;">, </span>
