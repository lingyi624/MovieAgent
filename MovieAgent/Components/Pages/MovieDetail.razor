    // 影评相关方法
    private void ShowReviewDialog()
    {
        _isEditingReview = false;
        _reviewRating = 5;
        _reviewContent = string.Empty;
        _editingReviewId = null;
        _reviewDialogVisible = true;
    }

    private void ShowEditReviewDialog(MovieAgent.Core.Entities.MovieReview review)
    {
        _isEditingReview = true;
        _reviewRating = review.Rating;
        _reviewContent = review.Content;
        _editingReviewId = review.Id;
        _reviewDialogVisible = true;
    }

    private void CloseReviewDialog()
    {
        _reviewDialogVisible = false;
        _isEditingReview = false;
        _reviewRating = 5;
        _reviewContent = string.Empty;
        _editingReviewId = null;
    }

    private async Task SaveReview()
    {
        if (string.IsNullOrWhiteSpace(_reviewContent) || _movie == null)
            return;

        if (_isEditingReview && _editingReviewId.HasValue)
        {
            // 编辑现有影评
            await ReviewService.UpdateReviewAsync(_editingReviewId.Value, _reviewContent, _reviewRating);
        }
        else
        {
            // 创建新影评
            await ReviewService.CreateReviewAsync(_localId, _reviewContent, _reviewRating);
        }

        await LoadReviews();
        CloseReviewDialog();
    }

    private async Task DeleteReview(MovieAgent.Core.Entities.MovieReview review)
    {
        await ReviewService.DeleteReviewAsync(review.Id);
        await LoadReviews();
    }
