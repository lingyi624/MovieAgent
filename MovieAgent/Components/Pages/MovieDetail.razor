    private RenderFragment RenderDirectorLinks(string director, string? directorTmdbId)
    {
        return builder =>
        {
            if (!string.IsNullOrEmpty(directorTmdbId) && long.TryParse(directorTmdbId, out var id))
            {
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Href", NavigationManager.ToAbsoluteUri($"/person/{id}").ToString());
                builder.AddAttribute(2, "Style", "color: #E94560; text-decoration: none;");
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b =>
                {
                    b.AddContent(0, director);
                }));
                builder.CloseComponent();
            }
            else
            {
                builder.OpenComponent<MudText>(0);
                builder.AddAttribute(1, "Typo", Typo.body2);
                builder.AddAttribute(2, "Style", "color: white;");
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b =>
                {
                    b.AddContent(0, director);
                }));
                builder.CloseComponent();
            }
        };
    }

    private RenderFragment RenderWriterLinks(string writers, string? writerTmdbIds)
    {
        return builder =>
        {
            var writerList = writers.Split(',');
            var idList = ParseIdList(writerTmdbIds);

            for (int i = 0; i < writerList.Length; i++)
            {
                var writer = writerList[i].Trim();
                var tmdbId = i < idList.Count ? idList[i] : null;

                if (!string.IsNullOrEmpty(tmdbId) && long.TryParse(tmdbId, out var id))
                {
                    builder.OpenComponent<MudLink>(i * 2);
                    builder.AddAttribute(i * 2 + 1, "Href", NavigationManager.ToAbsoluteUri($"/person/{id}").ToString());
                    builder.AddAttribute(i * 2 + 2, "Style", "color: #E94560; text-decoration: none;");
                    builder.AddAttribute(i * 2 + 3, "ChildContent", (RenderFragment)(b =>
                    {
                        b.AddContent(0, writer);
                    }));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudText>(i * 2);
                    builder.AddAttribute(i * 2 + 1, "Typo", Typo.body2);
                    builder.AddAttribute(i * 2 + 2, "Style", "color: white;");
                    builder.AddAttribute(i * 2 + 3, "ChildContent", (RenderFragment)(b =>
                    {
                        b.AddContent(0, writer);
                    }));
                    builder.CloseComponent();
                }

                if (i < writerList.Length - 1)
                {
                    builder.AddContent(i * 2 + 4, "、");
                }
            }
        };
    }

