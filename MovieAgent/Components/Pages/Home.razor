@page "/"
@inject IMovieRepository MovieRepo
@inject IMovieScannerService ScannerService
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager
@inject ILocalizationService LocalizationService

<PageTitle>Movie Agent - @LocalizationService.Translate("Home")</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="margin-bottom: 16px;">
    <MudText Typo="Typo.h4" Style="color: #E94560;">@LocalizationService.Translate("MoviePosterWall")</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartScan"
               StartIcon="@Icons.Material.Filled.Refresh" Style="background:#E94560;">
        @LocalizationService.Translate("ScanNAS")
    </MudButton>
</MudStack>

<!-- 筛选面板 -->
<MudPaper Style="background: #1A1A2E; padding: 10px 12px; border-radius: 8px; margin-bottom: 16px;">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="margin-bottom: 8px;">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Style="color: #888; margin-right: 8px;">类型:</MudText>
            <MudChip T="string" Color="@(_selectedGenres.Count == 0 ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ClearGenres()" Class="filter-chip-sm">全部</MudChip>
            @foreach (var genre in _allGenres.Take(30))
            {
                <MudChip T="string" Color="@(_selectedGenres.Contains(genre) ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ToggleGenre(genre)" Class="filter-chip-sm">@genre</MudChip>
            }
            @if (_allGenres.Count > 30)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Color="Color.Default">
                    @foreach (var genre in _allGenres.Skip(30))
                    {
                        <MudMenuItem OnClick="async () => await ToggleGenre(genre)">@genre</MudMenuItem>
                    }
                </MudMenu>
            }
        </MudStack>
        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="async () => await ResetFilters()" StartIcon="@Icons.Material.Filled.Refresh">重置</MudButton>
    </MudStack>

    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Style="margin-bottom: 8px;">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Style="color: #888; width: 48px;">分辨率</MudText>
            <MudChip T="string" Color="@(string.IsNullOrEmpty(_selectedResolution) ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ClearResolution()" Class="filter-chip-sm">全部</MudChip>
            @foreach (var resolution in _allResolutions)
            {
                <MudChip T="string" Color="@(_selectedResolution == resolution ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await SelectResolution(resolution)" Class="filter-chip-sm">@resolution</MudChip>
            }
        </MudStack>
        
        <MudDivider Vertical="true" Style="background: #444; height: 24px;" />
        
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Style="color: #888; width: 32px;">观看</MudText>
            <MudChip T="string" Color="@(_selectedWatched == null ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ClearWatched()" Class="filter-chip-sm">全部</MudChip>
            <MudChip T="string" Color="@(_selectedWatched == true ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await SelectWatched(true)" Class="filter-chip-sm">已看</MudChip>
            <MudChip T="string" Color="@(_selectedWatched == false ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await SelectWatched(false)" Class="filter-chip-sm">未看</MudChip>
        </MudStack>
        
        <MudDivider Vertical="true" Style="background: #444; height: 24px;" />
        
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Style="color: #888; width: 32px;">收藏</MudText>
            <MudChip T="string" Color="@(_selectedFavorite == null ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ClearFavorite()" Class="filter-chip-sm">全部</MudChip>
            <MudChip T="string" Color="@(_selectedFavorite == true ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await SelectFavorite(true)" Class="filter-chip-sm">已收藏</MudChip>
            <MudChip T="string" Color="@(_selectedFavorite == false ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await SelectFavorite(false)" Class="filter-chip-sm">未收藏</MudChip>
        </MudStack>
    </MudStack>

    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Style="margin-top: 8px;">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Style="flex: 1;">
            <MudText Typo="Typo.body2" Style="color: #888; width: 32px;">导演</MudText>
            <MudChip T="string" Color="@(_selectedDirectors.Count == 0 ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ClearDirectors()" Class="filter-chip-sm">全部</MudChip>
            @foreach (var dir in _allDirectors.Take(15))
            {
                <MudChip T="string" Color="@(_selectedDirectors.Contains(dir) ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ToggleDirector(dir)" Class="filter-chip-sm">@dir</MudChip>
            }
            @if (_allDirectors.Count > 15)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Color="Color.Default">
                    @foreach (var dir in _allDirectors.Skip(15))
                    {
                        <MudMenuItem OnClick="async () => await ToggleDirector(dir)">@dir</MudMenuItem>
                    }
                </MudMenu>
            }
        </MudStack>
    </MudStack>
    
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Style="margin-top: 8px;">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Style="flex: 1;">
            <MudText Typo="Typo.body2" Style="color: #888; width: 32px;">演员</MudText>
            <MudChip T="string" Color="@(_selectedCasts.Count == 0 ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ClearCasts()" Class="filter-chip-sm">全部</MudChip>
            @foreach (var cast in _allCasts.Take(15))
            {
                <MudChip T="string" Color="@(_selectedCasts.Contains(cast) ? Color.Primary : Color.Default)" Size="Size.Small" OnClick="async () => await ToggleCast(cast)" Class="filter-chip-sm">@cast</MudChip>
            }
            @if (_allCasts.Count > 15)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Color="Color.Default">
                    @foreach (var cast in _allCasts.Skip(15))
                    {
                        <MudMenuItem OnClick="async () => await ToggleCast(cast)">@cast</MudMenuItem>
                    }
                </MudMenu>
            }
        </MudStack>
    </MudStack>
</MudPaper>
 
<MudGrid>
    <MudItem xs="6" sm="3" md="2">
        <MudSelect @bind-Value="_sortBy" @bind-Value:after="OnSortChanged" Label="排序" Variant="Variant.Outlined" T="string" Margin="Margin.Dense">
            <MudSelectItem T="string" Value="@("created")">添加时间</MudSelectItem>
            <MudSelectItem T="string" Value="@("unwatched")">未观看</MudSelectItem>
            <MudSelectItem T="string" Value="@("recent")">最近</MudSelectItem>
            <MudSelectItem T="string" Value="@("filesize")">文件大小</MudSelectItem>
            <MudSelectItem T="string" Value="@("title")">标题</MudSelectItem>
            <MudSelectItem T="string" Value="@("year")">年份</MudSelectItem>
            <MudSelectItem T="string" Value="@("rating")">评分</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="6" sm="3" md="2">
        <MudSwitch @bind-Value="_sortDesc" @bind-Value:after="OnSortChanged" Label="降序" Color="Color.Primary" />
    </MudItem>
</MudGrid>

@if (_isScanning)
{
    <MudCard Elevation="4" Style="margin-bottom: 16px; padding: 16px; background: #2D2D44;">
        <MudText Typo="Typo.body1" Style="color: #E94560; font-weight: bold; margin-bottom: 12px;">@LocalizationService.Translate("ScanProgress")</MudText>
        
        <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
            @if (_scanStatus.Contains("扫描视频文件"))
            {
                <MudProgressCircular Size="Size.Medium" Color="Color.Primary" Indeterminate="true" Style="margin-right: 16px;" />
            }
            <MudProgressLinear 
                Color="Color.Primary" 
                Value="_scanProgressPercent" 
                Style="flex: 1;"
                showProgressValue="true" />
        </div>
        
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">@LocalizationService.Translate("Status"):</MudText>
                <MudText Typo="Typo.body1" Style="color: white;">@_scanStatus</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">@LocalizationService.Translate("Found"):</MudText>
                <MudText Typo="Typo.body1" Style="color: #4CAF50; font-weight: bold;">@_scanFoundCount @LocalizationService.Translate("Movies")</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">@LocalizationService.Translate("Imported"):</MudText> 
                <MudText Typo="Typo.body1" Style="color: #2196F3; font-weight: bold;">@_scanImportedCount @LocalizationService.Translate("Movies")  @DbImported 数据库  @VectorUpdated 向量数据库 @EmbeddingGenerated 模型嵌入文本</MudText>
            </MudItem>
        </MudGrid>
        
        @if (!string.IsNullOrEmpty(_scanCurrentFile))
        {
            <MudText Typo="Typo.caption" Style="color: gray; margin-top: 12px; font-style: italic;">
                @LocalizationService.Translate("CurrentProcessing"): @_scanCurrentFile
            </MudText>
        }
    </MudCard>
}

<MudText Style="color: gray; margin-bottom: 16px;">@LocalizationService.Translate("TotalMovies", _totalCount)</MudText>

<MudGrid>
    @foreach (var movie in _movies)
    {
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudCard Elevation="4" Class="movie-card" Style="cursor: pointer; transition: transform 0.2s;">
                    <MudCardMedia Image="@GetPosterUrl(movie)" Height="330" Style="object-fit: cover;" />
                    <MudCardContent Style="padding: 10px;">
                    <MudText Typo="Typo.body2" Style="font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #E0E0E0;">
                        @movie.Title
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: #888; margin-top: 4px;">
                        @(movie.ReleaseYear?.ToString() ?? "未知") | @(movie.Resolution ?? "未知")
                        @if (movie.Rating.HasValue)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #FFD700; vertical-align: middle; margin-left: 4px;" />
                            @movie.Rating.Value.ToString("0.0")
                        }
                    </MudText>
                    @if (!string.IsNullOrEmpty(movie.Genres))
                    {
                        <div style="margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px;">
                            @foreach (var genre in ParseGenres(movie.Genres))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="background: rgba(99, 102, 241, 0.3); border-color: rgba(99, 102, 241, 0.5); color: #A5B4FC; font-size: 10px;">
                                    @genre
                                </MudChip>
                            }
                        </div>
                    }
                    </MudCardContent>
                    <MudCardActions>
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary"
                                       OnClick="() => PlayMovie(movie)" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Secondary"
                                       OnClick="() => NavigateToDetail(movie.Id)" Size="Size.Small" />
                        @if (movie.IsWatched)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">@LocalizationService.Translate("Watched")</MudChip>
                        }
                    </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (_movies.Count == 0 && !_isScanning)
{
    <MudAlert Severity="Severity.Info" Style="margin-top: 40px;">
        @LocalizationService.Translate("NoData") @LocalizationService.Translate("ScanNAS") @LocalizationService.Translate("OrConfigureNAS")
    </MudAlert>
}

<MudPagination Selected="_currentPage" Count="_totalPages" SelectedChanged="OnPageChanged"
               Style="margin-top: 24px; justify-content: center;" />

@code {
    private List<Movie> _movies = new();
    private bool _isScanning;
    private string _scanStatus = "";
    private int _scanFoundCount = 0;
    private int _scanImportedCount = 0;
    private int _scanCurrentIndex = 0;
    private int _scanTotalFiles = 0;
    private string _scanCurrentFile = "";
    private int _scanProgressPercent = 0;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private string _sortBy = "created";
    private bool _sortDesc = true;
    private int DbImported=0;
    private int VectorUpdated = 0;
    private int EmbeddingGenerated = 0;


    // 筛选状态
    private List<string> _allGenres = new();
    private List<string> _selectedGenres = new();
    private List<string> _allResolutions = new() { "4K", "1080P", "720P", "480P" };
    private string? _selectedResolution;
    private bool? _selectedWatched;
    private bool? _selectedFavorite;
    private List<string> _allDirectors = new();
    private List<string> _selectedDirectors = new();
    private List<string> _allCasts = new();
    private List<string> _selectedCasts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptions();
        await LoadMovies();
    }

    private async Task LoadFilterOptions()
    {
        _allGenres = await MovieRepo.GetAllGenresAsync();
        _allDirectors = await MovieRepo.GetAllDirectorsAsync();
        _allCasts = await MovieRepo.GetAllCastsAsync();
    }

    private async Task LoadMovies()
    {
        var filter = new MovieFilter
        {
            Genres = _selectedGenres.Count > 0 ? _selectedGenres : null,
            Resolution = _selectedResolution,
            IsWatched = _selectedWatched,
            IsFavorite = _selectedFavorite,
            Director = _selectedDirectors.Count > 0 ? _selectedDirectors : null,
            Cast = _selectedCasts.Count > 0 ? _selectedCasts : null,
            SortBy = _sortBy,
            SortDescending = _sortDesc,
            Page = _currentPage,
            PageSize = 24
        };
        _movies = await MovieRepo.GetUniqueMoviesAsync(filter);
        _totalCount = await MovieRepo.GetUniqueMovieCountAsync(filter);
        _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / 24.0));
    }

    private async Task OnSortChanged()
    {
        _currentPage = 1;
        await LoadMovies();
    }

    // 筛选方法
    private async Task ToggleGenre(string genre)
    {
        if (_selectedGenres.Contains(genre))
            _selectedGenres.Remove(genre);
        else
            _selectedGenres.Add(genre);
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ClearGenres()
    {
        _selectedGenres.Clear();
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task SelectResolution(string resolution)
    {
        _selectedResolution = resolution;
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ClearResolution()
    {
        _selectedResolution = null;
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task SelectWatched(bool watched)
    {
        _selectedWatched = watched;
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ClearWatched()
    {
        _selectedWatched = null;
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task SelectFavorite(bool favorite)
    {
        _selectedFavorite = favorite;
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ClearFavorite()
    {
        _selectedFavorite = null;
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ToggleDirector(string director)
    {
        if (_selectedDirectors.Contains(director))
            _selectedDirectors.Remove(director);
        else
            _selectedDirectors.Add(director);
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ClearDirectors()
    {
        _selectedDirectors.Clear();
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ToggleCast(string cast)
    {
        if (_selectedCasts.Contains(cast))
            _selectedCasts.Remove(cast);
        else
            _selectedCasts.Add(cast);
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ClearCasts()
    {
        _selectedCasts.Clear();
        _currentPage = 1;
        await LoadMovies();
    }

    private async Task ResetFilters()
    {
        _selectedGenres.Clear();
        _selectedResolution = null;
        _selectedWatched = null;
        _selectedFavorite = null;
        _selectedDirectors.Clear();
        _selectedCasts.Clear();
        _currentPage = 1;
        await LoadMovies();
    }

    private string GetPosterUrl(Movie movie)
    {
        if (!string.IsNullOrWhiteSpace(movie.PosterPath))
            return $"https://image.tmdb.org/t/p/w342{movie.PosterPath}";
        return "images/placeholder-poster.png";
    }

    private async Task StartScan()
    {
        _isScanning = true;
        _scanStatus = "正在扫描NAS共享路径...";
        _scanFoundCount = 0;
        _scanImportedCount = 0;
        _scanCurrentIndex = 0;
        _scanTotalFiles = 0;
        _scanCurrentFile = "";
        _scanProgressPercent = 0;
        StateHasChanged();

        ScannerService.ScanProgressChanged += OnScanProgressChanged;

        try
        {
            var sharePaths = new List<string>();
            var shareFile = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "share.json");
            if (File.Exists(shareFile))
            {
                var json = await File.ReadAllTextAsync(shareFile);
                var config = System.Text.Json.JsonSerializer.Deserialize<ShareConfig>(json);
                if (config?.Shares != null) sharePaths = config.Shares;
            }

            _scanStatus = $"正在扫描 {sharePaths.Count} 个共享路径...";
            StateHasChanged();

            _scanStatus = "正在扫描视频文件...";
            _scanProgressPercent = 0;
            StateHasChanged();

            var files = MovieRepo.GetAllAsync().Result.Select(m => m.FilePath).ToList();
            //await ScannerService.ScanVideoFilesAsync(sharePaths);
            _scanFoundCount = files.Count;
            _scanTotalFiles = files.Count;
            StateHasChanged();

            if (files.Count > 0)
            {
                _scanStatus = "正在导入电影信息...";
                _scanProgressPercent = 0;
                StateHasChanged();

                var imported = await ScannerService.ImportNewMoviesAsync(files);
                _scanImportedCount = imported;
                _scanProgressPercent = 100;
                _scanStatus = $"导入完成！新增 {imported} 部电影";
            }
            else
            {
                _scanStatus = "扫描完成！未发现新视频文件";
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _scanStatus = $"扫描出错: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            ScannerService.ScanProgressChanged -= OnScanProgressChanged;
        }

        await Task.Delay(2000);

        _isScanning = false;
        await LoadMovies();
    }

    private async void OnScanProgressChanged(object? sender, ScanProgressEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.CurrentFileName))
        {
            _scanCurrentFile = e.CurrentFileName;
        }
        if (e.CurrentIndex > 0 && e.TotalFiles > 0)
        {
            _scanCurrentIndex = e.CurrentIndex;
            _scanProgressPercent = (int)((double)e.CurrentIndex / e.TotalFiles * 100);
            _scanImportedCount = e.TotalScanned;
        }
        DbImported = e.DbImported;
        VectorUpdated = e.VectorUpdated;
        EmbeddingGenerated = e.EmbeddingGenerated;
        await InvokeAsync(StateHasChanged);
    }

    private void PlayMovie(Movie movie)
    {
        NavigationManager.NavigateTo($"/movie/{movie.Id}/videos");
    }

    private void NavigateToDetail(int id) => NavigationManager.NavigateTo($"/movie/{id}");

    private List<string> ParseGenres(string genresJson)
    {
        try
        {
            var genres = System.Text.Json.JsonSerializer.Deserialize<List<string>>(genresJson);
            return genres?.Take(2).ToList() ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    private async Task OnPageChanged(int page) { _currentPage = page; await LoadMovies(); }

    public class ShareConfig { public List<string> Shares { get; set; } = new(); }
}