@page "/report"
@using MovieAgent.Infrastructure.Services
@inject IReportService ReportService

<PageTitle>观影报告</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Style="padding: 16px;">
    <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 24px; border-radius: 12px; margin-bottom: 16px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="margin-bottom: 24px;">
            <MudText Typo="Typo.h4" Style="color: #E94560;">观影报告</MudText>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect @bind-Value="_selectedYear" Label="选择年份" Variant="Variant.Outlined" T="int">
                    @for (int i = DateTime.Now.Year; i >= 2020; i--)
                    {
                        int year = i;
                        <MudSelectItem T="int" Value="@year">@year 年</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect @bind-Value="_selectedMonth" Label="选择月份" Variant="Variant.Outlined" T="int">
                    @for (int i = 1; i <= 12; i++)
                    {
                        int month = i;
                        <MudSelectItem T="int" Value="@month">@month 月</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Style="display: flex; align-items: flex-end;">
                <MudButton Color="Color.Dark" OnClick="GenerateMonthlyReport" Style="background:#E94560; margin-right: 8px;">
                    月度报告
                </MudButton>
                <MudButton Color="Color.Secondary" OnClick="GenerateYearlyReport">
                    年度报告
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 24px; border-radius: 12px; margin-bottom: 16px;">
        <MudButton Color="Color.Info" OnClick="GenerateAiInsights" Disabled="_isGeneratingInsights">
            @if (_isGeneratingInsights)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span style="margin-left: 8px;">正在生成洞察...</span>
            }
            else
            {
                <span>🤖 生成AI洞察</span>
            }
        </MudButton>
        @if (_isGeneratingInsights)
        {
            <MudText Typo="Typo.body2" Style="color: #9E9E9E; margin-top: 12px; display: block;">
                🧠 AI正在分析您的观影数据，请稍候...
            </MudText>
        }
    </MudPaper>

    @if (!string.IsNullOrEmpty(_reportContent))
    {
        <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 24px; border-radius: 12px;">
            <MudText Typo="Typo.h5" Style="color: #E94560; margin-bottom: 16px;">@_reportTitle</MudText>
            <pre style="white-space: pre-wrap; color: #E0E0E0; font-family: 'Microsoft YaHei', sans-serif; font-size: 14px;">@_reportContent</pre>
        </MudPaper>
    }
</MudContainer>

@code {
    private int _selectedYear = DateTime.Now.Year;
    private int _selectedMonth = DateTime.Now.Month;
    private string _reportContent = "";
    private string _reportTitle = "";
    private bool _isGeneratingInsights = false;

    private async Task GenerateMonthlyReport()
    {
        _reportContent = await ReportService.GenerateMonthlyReportAsync(_selectedYear, _selectedMonth);
        _reportTitle = $"{_selectedYear}年{_selectedMonth}月观影报告";
    }

    private async Task GenerateYearlyReport()
    {
        _reportContent = await ReportService.GenerateYearlyReportAsync(_selectedYear);
        _reportTitle = $"{_selectedYear}年度观影报告";
    }

    private async Task GenerateAiInsights()
    {
        _isGeneratingInsights = true;
        try
        {
            _reportContent = await ReportService.GenerateAiInsightsAsync();
            _reportTitle = "AI观影洞察";
        }
        finally
        {
            _isGeneratingInsights = false;
        }
    }
}
