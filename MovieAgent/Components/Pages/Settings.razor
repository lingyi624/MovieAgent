@page "/settings"
@inject IConfiguration Config
@inject ISnackbar Snackbar
@inject ILocalizationService LocalizationService
@inject IBackupService BackupService
@inject IMovieExportService ExportService
@inject IMovieDownloadService DownloadService
@inject IMovieRepository MovieRepo
@using MovieAgent.Infrastructure.Providers
@using MovieAgent.Core.Interfaces
@using MovieAgent.Core.Models
@using System.Text.Json
@using System.Text
@using Newtonsoft.Json.Linq;

<PageTitle>@LocalizationService.Translate("Settings")</PageTitle>

<MudText Typo="Typo.h4" GutterBottom Style="color: #E94560;">@LocalizationService.Translate("Settings")</MudText>

<MudTabs Elevation="2" Rounded="true" Style="background: linear-gradient(135deg, #2D2D44 0%, #1A1A2E 100%); color: #E0E0E0;" >
    <MudTabPanel Text="@LocalizationService.Translate("Language")" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">@LocalizationService.Translate("Language")</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudText Typo="Typo.body1" Style="margin-bottom: 16px;">@LocalizationService.Translate("CurrentLanguage"): @CurrentLanguageText</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SetLanguage(Language.Chinese)" 
                               Style="@(LocalizationService.CurrentLanguage == Language.Chinese ? "background: #E94560;" : "background: #3D3D5C;")">
                        🇨🇳 中文
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SetLanguage(Language.English)"
                               Style="@(LocalizationService.CurrentLanguage == Language.English ? "background: #E94560;" : "background: #3D3D5C;")">
                        🇬🇧 English
                    </MudButton>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Style="color: #888; margin-top: 16px;">@LocalizationService.Translate("LanguageRestartHint")</MudText>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="NAS 共享" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">NAS 共享路径配置</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #1A1A2E;">
            @foreach (var share in _shares)
            {
                <MudGrid Style="margin-bottom: 8px;">
                    <MudItem xs="8">
                        <MudTextField @bind-Value="share.Path" Label="共享路径" Variant="Variant.Outlined"
                                      Placeholder="\\192.168.1.11\disk1" Style="background: #2D2D44;" />
                    </MudItem>
                    <MudItem xs="1" Style="display: flex; align-items: center; justify-content: center;">
                        <MudChip T="string" Color="@(share.IsOnline ? Color.Success : Color.Error)" Size="Size.Small">
                            @(share.IsOnline ? "在线" : "离线")
                        </MudChip>
                    </MudItem>
                    <MudItem xs="2" Style="display: flex; align-items: center; justify-content: center;">
                        <MudIconButton Icon="@Icons.Material.Filled.Wifi" Color="Color.Info" OnClick="() => TestShareConnection(share)" title="测试连接" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => RemoveShare(share)" title="删除" />
                    </MudItem>
                </MudGrid>
            }
            <MudButton Variant="Variant.Outlined" OnClick="AddShare" StartIcon="@Icons.Material.Filled.Add">添加共享路径</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveShares" Style="margin-left: 8px; background: #E94560;">保存</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="TestAllConnections" StartIcon="@Icons.Material.Filled.Refresh" Style="margin-left: 8px;">测试所有连接</MudButton>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="播放器" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">外部播放器配置</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudTextField @bind-Value="_playerPath" Label="播放器路径" Variant="Variant.Outlined"
                          Placeholder="C:\Program Files\DAUM\PotPlayer\PotPlayerMini64.exe"
                          HelperText="留空使用系统默认播放器" Style="margin-bottom: 16px; background: #2D2D44;" />
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="BrowsePlayer" StartIcon="@Icons.Material.Filled.FolderOpen">浏览</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePlayerSettings" Style="margin-left: 8px; background: #E94560;">保存</MudButton>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="TMDB API" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">TMDB API 配置</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudTextField @bind-Value="_tmdbApiKey" Label="API Key" Variant="Variant.Outlined" InputType="InputType.Password"
                          Placeholder="输入你的 TMDB API Key" Style="margin-bottom: 16px; background: #2D2D44;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTmdbSettings" Style="background: #E94560;">保存</MudButton>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="字幕下载" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">OpenSubtitles API 配置</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudTextField @bind-Value="_subtitleApiKey" Label="API Key" Variant="Variant.Outlined" InputType="InputType.Password"
                          Placeholder="输入你的 OpenSubtitles API Key" Style="margin-bottom: 16px; background: #2D2D44;" />
            <MudText Typo="Typo.body2" Style="color: #888; margin-bottom: 16px;">
                你可以在 <a href="https://www.opensubtitles.com/" target="_blank" style="color: #E94560;">OpenSubtitles 官网</a> 申请免费的 API Key。
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSubtitleSettings" Style="background: #E94560;">保存</MudButton>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="下载设置" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">4K 电影下载配置</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudTextField @bind-Value="_downloadDir" Label="本地下载目录" Variant="Variant.Outlined"
                          Placeholder="D:\Movies\Downloads" Style="margin-bottom: 16px; background: #2D2D44;" />
            <MudTextField @bind-Value="_nasDownloadDir" Label="NAS 下载目录" Variant="Variant.Outlined"
                          Placeholder="\\192.168.1.11\disk1\downloads" Style="margin-bottom: 16px; background: #2D2D44;" />
            <MudSwitch @bind-Value="_useNasForDownload" Label="使用 NAS 作为下载目录" 
                       Color="Color.Primary" Style="margin-bottom: 16px;" />
            <MudGrid>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_maxConcurrentDownloads" Label="最大并发下载数" 
                                     Variant="Variant.Outlined" Min="1" Max="10" Step="1"
                                     Style="background: #2D2D44;" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_maxRetries" Label="最大重试次数" 
                                     Variant="Variant.Outlined" Min="0" Max="10" Step="1"
                                     Style="background: #2D2D44;" />
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="BrowseDownloadDir" 
                       StartIcon="@Icons.Material.Filled.FolderOpen" Style="margin-top: 16px;">浏览</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDownloadSettings" 
                       Style="margin-left: 8px; margin-top: 16px; background: #E94560;">保存</MudButton>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="AI 模型" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">AI 模型配置</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="_selectedModel" Label="选择模型" Variant="Variant.Outlined"
                               Style="background: #2D2D44; margin-bottom: 16px;"
                               Clearable="false">
                        <MudSelectItem T="ModelConfig" Value="null">选择模型...</MudSelectItem>
                        @foreach (var model in _availableModels)
                        {
                            <MudSelectItem T="ModelConfig" Value="@model">
                                @model.Name (@model.ProviderType)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_apiKey" Label="API Key (DeepSeek 需要)" 
                                  Variant="Variant.Outlined" InputType="InputType.Password"
                                  Placeholder="输入 API Key" Style="background: #2D2D44; margin-bottom: 16px;" />
                </MudItem>
            </MudGrid>
            
            @if (_selectedModel != null && _selectedModel.ProviderType == ModelProviderType.Ollama)
            {
                <MudTextField @bind-Value="_ollamaEndpoint" Label="Ollama 地址" Variant="Variant.Outlined"
                              Placeholder="http://localhost:11434" Style="background: #2D2D44; margin-bottom: 16px;" />
            }
            
            @if (_selectedModel != null && _selectedModel.ProviderType == ModelProviderType.DeepSeek)
            {
                <MudTextField @bind-Value="_deepseekEndpoint" Label="DeepSeek API 地址" Variant="Variant.Outlined"
                              Placeholder="https://api.deepseek.com/v1" Style="background: #2D2D44; margin-bottom: 16px;" />
            }
            
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAiSettings" Style="background: #E94560;">保存</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="TestAiConnection" 
                       StartIcon="@Icons.Material.Filled.Refresh" Style="margin-left: 8px;">测试连接</MudButton>
            
            @if (!string.IsNullOrEmpty(_aiTestResult))
            {
                <MudText Typo="Typo.body2" Style="@($"{(_aiTestSuccess ? "color: #4CAF50;" : "color: #E94560;")}margin-top: 12px; display: block;")">@_aiTestResult</MudText>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="数据库备份" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">数据库备份策略</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudStack Spacing="4" Style="margin-bottom: 16px;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateBackup" StartIcon="@Icons.Material.Filled.Backup" Style="background: #E94560;">
                    创建备份
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CleanupOldBackups" StartIcon="@Icons.Material.Filled.DeleteSweep">
                    清理旧备份（保留最近7天）
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.body2" Style="color: #888; margin-bottom: 12px;">备份文件列表：</MudText>
            <div style="max-height: 300px; overflow-y: auto;">
                @if (_backups.Any())
                {
                    <MudList T="BackupInfo">
                        @foreach (var backup in _backups)
                        {
                            <MudListItem T="BackupInfo">
                                <div class="d-flex justify-between align-items-center flex-wrap" Style="width: 100%;">
                                    <MudText Style="color: #E0E0E0; flex: 1;">@backup.Name</MudText>
                                    <MudText Style="color: #888; font-size: 12px; margin-right: 12px;">@backup.Size</MudText>
                                    <div class="d-flex gap-2">
                                        <MudIconButton Icon="@Icons.Material.Filled.Restore" Color="Color.Info" OnClick="() => RestoreBackup(backup.Path)" title="恢复备份" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteBackup(backup.Path)" title="删除备份" />
                                    </div>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color: #888; text-align: center; padding: 20px;">暂无备份文件</MudText>
                }
            </div>
            <MudText Typo="Typo.caption" Style="color: #666; margin-top: 12px; display: block;">
                备份文件存储位置: @_backupDirectory
            </MudText>
        </MudPaper>
    </MudTabPanel>
    
    <MudTabPanel Text="数据导出/导入" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">电影库数据管理</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudStack Spacing="4" Style="margin-bottom: 16px;">
                <MudText Typo="Typo.body2" Style="color: #888;">导出电影库数据为 JSON 或 CSV 格式，方便备份和迁移。</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportToJson" StartIcon="@Icons.Material.Filled.TextSnippet" Style="background: #E94560;">
                        导出为 JSON
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportToCsv" StartIcon="@Icons.Material.Filled.ViewList" Style="background: #4CAF50;">
                        导出为 CSV
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ImportFromFile" StartIcon="@Icons.Material.Filled.Upload">
                        从文件导入
                    </MudButton>
                </MudStack>
            </MudStack>

            @if (_exporting)
            {
                <div style="display: flex; align-items: center; gap: 12px;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Style="color: #E94560;">@_exportProgress</MudText>
                </div>
            }

            @if (!string.IsNullOrEmpty(_exportMessage))
            {
                <MudText Typo="Typo.body2" Style="@(_exportSuccess ? "color: #4CAF50;" : "color: #E94560;")">
                    @_exportMessage
                </MudText>
            }
        </MudPaper>
    </MudTabPanel>
    
    <MudTabPanel Text="语音测试" Style="background: #1A1A2E; color: #E0E0E0;">
        <MudText Typo="Typo.h6" Style="margin: 16px 0;">语音输入测试</MudText>
        <MudPaper Elevation="1" Style="padding: 16px; background: #2D2D44;">
            <MudStack Spacing="4" Style="margin-bottom: 16px;">
                <MudText Typo="Typo.body2" Style="color: #888;">测试语音识别功能，请确保麦克风已正确连接。</MudText>
                
                <div style="display: flex; align-items: center; gap: 12px;">
                    <MudChip T="string" Color="@(_isSpeechAvailable ? Color.Success : Color.Error)">
                        @(_isSpeechAvailable ? "语音服务可用" : "语音服务不可用")
                    </MudChip>
                    <MudChip T="string" Color="@(_isListening ? Color.Warning : Color.Info)">
                        @(_isListening ? "正在监听" : "未监听")
                    </MudChip>
                </div>
                
                <MudTextField @bind-Value="_recognizedText" Label="识别结果" Variant="Variant.Outlined"
                              Placeholder="点击开始监听后说话..." Style="background: #2D2D44;"
                              ReadOnly="true" Multiline="true" Rows="3" />
                
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="@(_isListening ? Color.Error : Color.Primary)" 
                               OnClick="ToggleListening" 
                               Style="@(_isListening ? "background: #E94560;" : "background: #4CAF50;")">
                        @(_isListening ? "停止监听" : "开始监听")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="TestSpeak" StartIcon="@Icons.Material.Filled.VolumeUp">
                        测试语音合成
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearRecognition">
                        清空结果
                    </MudButton>
                </MudStack>
                
                @if (_isListening)
                {
                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                        <div class="voice-wave">
                            <div class="wave-bar"></div>
                            <div class="wave-bar"></div>
                            <div class="wave-bar"></div>
                            <div class="wave-bar"></div>
                            <div class="wave-bar"></div>
                        </div>
                        <MudText Typo="Typo.body2" Style="color: #4CAF50;">正在监听，请说话...</MudText>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(_speechStatus))
                {
                    <MudText Typo="Typo.body2" Style="@(_speechStatus.Contains("成功") ? "color: #4CAF50;" : "color: #E94560;")">
                        @_speechStatus
                    </MudText>
                }
            </MudStack>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private List<ShareItem> _shares = new();
    private string _playerPath = "";
    private string _tmdbApiKey = "";
    private string _subtitleApiKey = "";
    private string _modelUrl = "http://localhost:11434";
    private string _modelName = string.Empty;
    private List<BackupInfo> _backups = new();
    private string _backupDirectory = "";
    private bool _exporting = false;
    private string _exportProgress = "";
    private string _exportMessage = "";
    private bool _exportSuccess = false;

    // 下载设置
    private string _downloadDir = @"D:\Movies\Downloads";
    private string _nasDownloadDir = "";
    private bool _useNasForDownload;
    private int _maxConcurrentDownloads = 3;
    private int _maxRetries = 3;

    // AI 模型配置
    private List<ModelConfig> _availableModels = new();
    private ModelConfig? _selectedModel;
    private string _apiKey = "";
    private string _ollamaEndpoint = "http://localhost:11434";
    private string _deepseekEndpoint = "https://api.deepseek.com/v1";
    private string _aiTestResult = "";
    private bool _aiTestSuccess = false;

    // 语音测试配置
    [Inject] private ISpeechService SpeechService { get; set; } = null!;
    private bool _isSpeechAvailable = false;
    private bool _isListening = false;
    private string _recognizedText = "";
    private string _speechStatus = "";

    private string CurrentLanguageText => LocalizationService.CurrentLanguage == Language.Chinese ? "中文" : "English";

    protected override async Task OnInitializedAsync()
    {
        LoadShares();
        _playerPath = Config["Player:Path"] ?? "";
        _tmdbApiKey = Config["TMDB:ApiKey"] ?? "";
        _subtitleApiKey = Config["Subtitle:ApiKey"] ?? "";
        _modelUrl = Config["AI:ModelUrl"] ?? "http://localhost:11434";
        _modelName = Config["AI:ModelName"] ?? "phi3.5:3.8b-mini-instruct-q4_K_M";
        LoadBackups();
        LoadAiModels();
            LoadDownloadSettings();

            await InitializeSpeechService();
    }

    private async Task InitializeSpeechService()
    {
        try
        {
            await SpeechService.InitializeAsync();
            _isSpeechAvailable = SpeechService.IsAvailable;
            _speechStatus = _isSpeechAvailable ? "语音服务初始化成功" : "语音服务初始化失败";
        }
        catch (Exception ex)
        {
            _isSpeechAvailable = false;
            _speechStatus = $"语音服务初始化异常: {ex.Message}";
        }
        StateHasChanged();
    }

    private void ToggleListening()
    {
        if (!_isSpeechAvailable)
        {
            _speechStatus = "语音服务不可用，请检查麦克风和系统语音配置";
            StateHasChanged();
            return;
        }

        if (_isListening)
        {
            SpeechService.StopListening();
            _isListening = false;
            _speechStatus = "监听已停止";
        }
        else
        {
            _recognizedText = "";
            _isListening = true;
            _speechStatus = "开始监听，请说话...";
            SpeechService.StartListening(OnSpeechResult);
        }
        StateHasChanged();
    }

    private void OnSpeechResult(string text)
    {
        _recognizedText += (string.IsNullOrEmpty(_recognizedText) ? "" : "\n") + text;
        _speechStatus = $"识别成功: {text}";
        StateHasChanged();
    }

    private async void TestSpeak()
    {
        try
        {
            _speechStatus = "正在播放测试语音...";
            StateHasChanged();
            await SpeechService.SpeakAsync("你好，我是电影智能小管家小雪雪。语音合成测试成功！");
            _speechStatus = "语音合成测试成功";
        }
        catch (Exception ex)
        {
            _speechStatus = $"语音合成失败: {ex.Message}";
        }
        StateHasChanged();
    }

    private void ClearRecognition()
    {
        _recognizedText = "";
        _speechStatus = "";
    }

    private void LoadAiModels()
    {
        _availableModels = ChatProviderFactory.GetDefaultModels();

        var savedModelName = Config["AI:ModelName"] ?? "";
        var savedProvider = Config["AI:Provider"] ?? "Ollama";

        _selectedModel = _availableModels.FirstOrDefault(m => 
            m.Name == savedModelName && m.ProviderType.ToString() == savedProvider);

        if (_selectedModel == null && _availableModels.Any())
        {
            _selectedModel = _availableModels.First(m => m.IsDefault);
        }

        _apiKey = Config["AI:ApiKey"] ?? "";
        _ollamaEndpoint = Config["AI:ModelUrl"] ?? "http://localhost:11434";
        _deepseekEndpoint = Config["AI:DeepSeekUrl"] ?? "https://api.deepseek.com/v1";
    }

    private async void TestAiConnection()
    {
        if (_selectedModel == null)
        {
            _aiTestResult = "请先选择模型";
            _aiTestSuccess = false;
            StateHasChanged();
            return;
        }

        _aiTestResult = "测试连接中...";
        StateHasChanged();

        try
        {
            var config = new ModelConfig
            {
                Name = _selectedModel.Name,
                Endpoint = _selectedModel.ProviderType switch
                {
                    ModelProviderType.Ollama => _ollamaEndpoint,
                    ModelProviderType.DeepSeek => _deepseekEndpoint,
                    _ => _selectedModel.Endpoint
                },
                ApiKey = _apiKey,
                ProviderType = _selectedModel.ProviderType
            };

            var provider = ChatProviderFactory.CreateProvider(config);
            bool success = await provider.InitializeAsync();

            if (success)
            {
                _aiTestResult = "连接成功！";
                _aiTestSuccess = true;
            }
            else
            {
                _aiTestResult = $"连接失败: {provider.LastError}";
                _aiTestSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _aiTestResult = $"测试失败: {ex.Message}";
            _aiTestSuccess = false;
        }

        StateHasChanged();
    }

    private IEnumerable<ModelConfig> SearchModels(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return _availableModels;

        return _availableModels.Where(m => 
            m.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            m.ProviderType.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }

    private void LoadBackups()
    {
        _backupDirectory = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "backups");
        _backups.Clear();

        if (Directory.Exists(_backupDirectory))
        {
            var backupDirs = Directory.GetDirectories(_backupDirectory);
            foreach (var dir in backupDirs)
            {
                var name = Path.GetFileName(dir);
                if (DateTime.TryParseExact(name, "yyyyMMdd_HHmmss", null, System.Globalization.DateTimeStyles.None, out var date))
                {
                    var size = GetDirectorySize(dir);
                    _backups.Add(new BackupInfo
                    {
                        Name = date.ToString("yyyy-MM-dd HH:mm:ss"),
                        Path = dir,
                        Size = FormatSize(size)
                    });
                }
            }
            _backups.Sort((a, b) => b.Name.CompareTo(a.Name));
        }
    }

    private long GetDirectorySize(string path)
    {
        try
        {
            return new DirectoryInfo(path).EnumerateFiles("*.*", SearchOption.AllDirectories).Sum(f => f.Length);
        }
        catch
        {
            return 0;
        }
    }

    private string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

