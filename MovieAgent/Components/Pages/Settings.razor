            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"测试连接失败: {ex.Message}", Severity.Error);
        }
    }

    private void TestAllConnections()
    {
        int successCount = 0;
        int failCount = 0;
        
        foreach (var share in _shares)
        {
            if (!string.IsNullOrWhiteSpace(share.Path))
            {
                share.IsOnline = Directory.Exists(share.Path);
                if (share.IsOnline)
                    successCount++;
                else
                    failCount++;
            }
        }
        
        StateHasChanged();
        
        if (failCount == 0)
        {
            Snackbar.Add($"所有 {successCount} 个共享路径连接成功", Severity.Success);
        }
        else if (successCount == 0)
        {
            Snackbar.Add($"所有 {failCount} 个共享路径连接失败", Severity.Error);
        }
        else
        {
            Snackbar.Add($"{successCount} 个成功，{failCount} 个失败", Severity.Warning);
        }
    }

