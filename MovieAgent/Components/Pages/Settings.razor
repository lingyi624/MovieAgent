    private async void ImportFromFile()
    {
        var openDialog = new Microsoft.Win32.OpenFileDialog
        {
            Filter = "JSON 文件|*.json|CSV 文件|*.csv|所有文件|*.*"
        };

        if (openDialog.ShowDialog() != true)
            return;

        try
        {
            _exporting = true;
            _exportProgress = "正在读取文件...";
            _exportMessage = "";
            StateHasChanged();

            var fileInfo = new FileInfo(openDialog.FileName);
            List<MovieAgent.Core.Entities.Movie> movies;

            if (fileInfo.Extension.Equals(".json", StringComparison.OrdinalIgnoreCase))
            {
                var json = await File.ReadAllTextAsync(openDialog.FileName);
                movies = await ExportService.ImportFromJsonAsync(json);
            }
            else if (fileInfo.Extension.Equals(".csv", StringComparison.OrdinalIgnoreCase))
            {
                var csv = await File.ReadAllTextAsync(openDialog.FileName);
                movies = await ExportService.ImportFromCsvAsync(csv);
            }
            else
            {
                _exportSuccess = false;
                _exportMessage = "不支持的文件格式";
                _exporting = false;
                StateHasChanged();
                return;
            }

            _exportProgress = "正在导入数据...";
            StateHasChanged();

            int imported = 0;
            int skipped = 0;

            foreach (var movie in movies)
            {
                var existing = await MovieRepo.GetByIdAsync(movie.Id);
                if (existing == null)
                {
                    await MovieRepo.AddAsync(movie);
                    imported++;
                }
                else
                {
                    skipped++;
                }
            }

            _exportSuccess = true;
            _exportMessage = $"导入完成: 成功 {imported} 部，跳过 {skipped} 部（已存在）";
            Snackbar.Add(_exportMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            _exportSuccess = false;
            _exportMessage = $"导入失败: {ex.Message}";
            Snackbar.Add(_exportMessage, Severity.Error);
        }
        finally
        {
            _exporting = false;
            _exportProgress = "";
            StateHasChanged();
        }
    }

    private void LoadDownloadSettings()
    {
        _downloadDir = Config["Download:DownloadDirectory"] ?? @"D:\Movies\Downloads";
        _nasDownloadDir = Config["Download:NasDownloadDirectory"] ?? "";
        _useNasForDownload = bool.TryParse(Config["Download:UseNasForDownload"], out var un) && un;
        _maxConcurrentDownloads = int.TryParse(Config["Download:MaxConcurrentDownloads"], out var mc) ? mc : 3;
        _maxRetries = int.TryParse(Config["Download:MaxRetries"], out var mr) ? mr : 3;
    }

    private void BrowseDownloadDir()
    {
        var dialog = new System.Windows.Forms.FolderBrowserDialog
        {
            Description = "选择下载目录",
            ShowNewFolderButton = true
        };
        if (dialog.ShowDialog() == System.Windows.Forms.DialogResult.OK)
            _downloadDir = dialog.SelectedPath;
    }

    private async void SaveDownloadSettings()
    {
        try
        {
            var config = new Dictionary<string, object>
            {
                ["Download:DownloadDirectory"] = _downloadDir,
                ["Download:NasDownloadDirectory"] = _nasDownloadDir,
                ["Download:UseNasForDownload"] = _useNasForDownload.ToString().ToLower(),
                ["Download:MaxConcurrentDownloads"] = _maxConcurrentDownloads.ToString(),
                ["Download:MaxRetries"] = _maxRetries.ToString()
            };

            SaveAppSettings(config);

            await DownloadService.UpdateSettingsAsync(new DownloadSettings
            {
                DownloadDirectory = _downloadDir,
                NasDownloadDirectory = _nasDownloadDir,
                UseNasForDownload = _useNasForDownload,
                MaxConcurrentDownloads = _maxConcurrentDownloads,
                MaxRetries = _maxRetries
            });

            Snackbar.Add("下载设置已保存", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
