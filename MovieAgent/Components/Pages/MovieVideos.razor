@page "/movie/{movieId:int}/videos"
@inject IMovieRepository MovieRepo
@inject NavigationManager NavigationManager
@inject IPlayerService PlayerService
@inject MovieAgent.Infrastructure.Services.IDoubanService DoubanService

<PageTitle>视频列表</PageTitle>

@if (_loading)
{
    <div style="text-align: center; padding: 40px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
    </div>
}
else if (_movie == null)
{
    <MudAlert Severity="Severity.Error">电影信息未找到</MudAlert>
}
else
{
    <MudStack Spacing="4" Style="margin-bottom: 20px;">
        <MudButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="GoBack">返回</MudButton>
    </MudStack>

    <MudCard Style="background: #1A1A2E;">
        <MudCardMedia>
            @if (!string.IsNullOrWhiteSpace(_movie.PosterPath))
            {
                <img src="https://image.tmdb.org/t/p/w780/@_movie.PosterPath" 
                     alt="@_movie.Title" 
                     style="width: 100%; height: 200px; object-fit: cover;" />
            }
            <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.8)); padding: 20px;">
                <MudText Typo="Typo.h3" Style="color: white; font-weight: bold;">@_movie.Title</MudText>
                <MudText Typo="Typo.body2" Style="color: #ccc;">
                    @_movie.ReleaseYear · @_movie.Resolution · @FormatRuntime(_movie.Runtime)
                </MudText>
            </div>
        </MudCardMedia>
        <MudCardContent>
            <MudText Typo="Typo.body1" Style="color: #E0E0E0; margin-bottom: 8px;">
                @_movie.Overview
            </MudText>
            <MudStack Row="true" Spacing="4" Style="margin-top: 12px;">
                @if (_movie.Rating.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #FFD700;" />
                        <MudText>@_movie.Rating.Value.ToString("0.0")</MudText>
                    </MudChip>
                }
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@_movie.Country</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@_movie.Language</MudChip>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <MudCard Style="background: #1A1A2E; margin-top: 20px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Style="color: #E94560;">
                    @(_isTvShow ? "剧集列表" : "视频文件")
                </MudText>
                <MudText Typo="Typo.body2" Style="color: gray;">
                    共 @_videoFiles.Count 个视频
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudList T="string">
                @foreach (var (video, index) in _videoFiles.Select((v, i) => (v, i)))
                {
                    <MudListItem T="string" Clickable="true" 
                                 OnClick="async () => await PlayVideo(video)"
                                 Style="cursor: pointer; border-radius: 8px; margin-bottom: 8px; background: rgba(255,255,255,0.05);">
                        <div style="display: flex; align-items: center; width: 100%;">
                            <div style="width: 48px; height: 48px; background: #E94560; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 16px;">
                                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" Style="color: white;" />
                            </div>
                            <div style="flex: 1;">
                                <MudText Typo="Typo.body1" Style="color: white;">
                                    @(_isTvShow ? $"第 {index + 1} 集" : Path.GetFileName(video))
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: gray;">
                                    @video
                                </MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Medium" Style="color: #888;" />
                        </div>
                    </MudListItem>
                }
            </MudList>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter]
    public int movieId { get; set; }

    private Movie? _movie;
    private List<string> _videoFiles = new();
    private bool _loading = true;
    private bool _isTvShow = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadMovieInfo();
    }

    private async Task LoadMovieInfo()
    {
        _loading = true;
        try
        {
            _movie = await MovieRepo.GetByIdAsync(movieId);
            if (_movie != null)
            {
                // 自动获取海报和媒体信息（如果数据库中没有）
                if (string.IsNullOrEmpty(_movie.PosterPath))
                {
                    // 先尝试从豆瓣获取
                    var doubanInfo = await DoubanService.SearchMovieAsync(_movie.Title, _movie.ReleaseYear);
                    if (doubanInfo != null)
                    {
                        if (!string.IsNullOrEmpty(doubanInfo.Poster))
                            _movie.PosterPath = doubanInfo.Poster;
                        if (doubanInfo.Rating.HasValue)
                            _movie.Rating = doubanInfo.Rating.Value;
                        if (!string.IsNullOrEmpty(doubanInfo.Director))
                            _movie.Director = doubanInfo.Director;
                        if (!string.IsNullOrEmpty(doubanInfo.Genres))
                            _movie.Genres = doubanInfo.Genres;
                        if (!string.IsNullOrEmpty(doubanInfo.Country))
                            _movie.Country = doubanInfo.Country;
                        if (!string.IsNullOrEmpty(doubanInfo.Language))
                            _movie.Language = doubanInfo.Language;
                        if (!string.IsNullOrEmpty(doubanInfo.Summary))
                            _movie.Overview = doubanInfo.Summary;

                        await MovieRepo.UpdateAsync(_movie);
                    }
                    else
                    {
                        // 如果豆瓣没有找到，尝试从本地目录获取
                        await MovieRepo.UpdatePosterFromDirectoryAsync(_movie);
                        await MovieRepo.UpdateMediaInfoFromDirectoryAsync(_movie);
                        _movie = await MovieRepo.GetByIdAsync(movieId); // 重新加载
                    }
                }

                var videoPaths = await MovieRepo.GetMovieVideoPathsAsync(movieId);
                _videoFiles = videoPaths.ToList();
                _isTvShow = _videoFiles.Count > 1;
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task PlayVideo(string filePath)
    {
         PlayerService.RequestPlayback(filePath);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo($"/");
    }

    private string FormatRuntime(int? runtime)
    {
        if (!runtime.HasValue) return "未知时长";
        int hours = runtime.Value / 60;
        int minutes = runtime.Value % 60;
        if (hours > 0)
            return $"{hours}小时{minutes}分钟";
        return $"{minutes}分钟";
    }
}