    private RenderFragment RenderCompanyLinks(string companies, string? companyIds)
    {
        return builder =>
        {
            List<string> companyList;
            try
            {
                companyList = System.Text.Json.JsonSerializer.Deserialize<List<string>>(companies) ?? new List<string>();
            }
            catch
            {
                companyList = companies.Split('、').ToList();
            }
            
            var idList = ParseIdList(companyIds);
            
            for (int i = 0; i < Math.Min(companyList.Count, 3); i++)
            {
                var company = companyList[i];
                var tmdbId = i < idList.Count ? idList[i] : null;
                
                if (!string.IsNullOrEmpty(tmdbId) && long.TryParse(tmdbId, out var id))
                {
                    builder.OpenComponent<MudLink>(i * 2);
                    builder.AddAttribute(i * 2 + 1, "Href", NavigationManager.ToAbsoluteUri($"/company/{id}").ToString());
                    builder.AddAttribute(i * 2 + 2, "Style", "color: #E94560; text-decoration: none;");
                    builder.AddAttribute(i * 2 + 3, "ChildContent", (RenderFragment)(b =>
                    {
                        b.AddContent(0, company);
                    }));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudText>(i * 2);
                    builder.AddAttribute(i * 2 + 1, "Typo", Typo.body2);
                    builder.AddAttribute(i * 2 + 2, "Style", "color: white;");
                    builder.AddAttribute(i * 2 + 3, "ChildContent", (RenderFragment)(b =>
                    {
                        b.AddContent(0, company);
                    }));
                    builder.CloseComponent();
                }
                
                if (i < Math.Min(companyList.Count, 3) - 1)
                {
                    builder.AddContent(i * 2 + 4, "、");
                }
            }
        };
    }

    private List<string> ParseIdList(string? jsonIds)
    {
        if (string.IsNullOrEmpty(jsonIds)) return new List<string>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(jsonIds) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }
