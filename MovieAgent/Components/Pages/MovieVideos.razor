@page "/movie/{movieId:int}/videos"
@inject IMovieRepository MovieRepo
@inject NavigationManager NavigationManager
@inject IPlayerService PlayerService
@inject MovieAgent.Infrastructure.Services.IDoubanService DoubanService
@inject IJSRuntime JSRuntime

<PageTitle>@(_movie?.Title ?? "视频列表")</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="position: relative; overflow: hidden;margin-bottom: 20px; z-index: 2;">
    <MudText Typo="Typo.h4" Style="color: #E94560;">电影详情</MudText>
    <MudButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(async () => await GoBackAsync())">返回</MudButton>
</MudStack>

@if (_loading)
{
    <div style="text-align: center; padding: 40px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
    </div>
}
else if (_movie == null)
{
    <MudAlert Severity="Severity.Error">电影信息未找到</MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_movie.BackdropPath))
    {
        <div style="position: absolute; top: 0; right: 0; width: 100%; height: 100%; opacity: 1;">
            <img src="https://image.tmdb.org/t/p/w1280/@_movie.BackdropPath"
                 alt="@_movie.Title"
                 style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
    }

    <MudGrid>
        <!-- 左侧 - 海报和基本信息 -->
        <MudItem xs="12" md="4">
            <MudCard Style="background: #1A1A2E; position: relative; overflow: hidden; border-radius: 8px;opacity: 0.8;">
                @if (!string.IsNullOrWhiteSpace(_movie.PosterPath))
                {
                    <MudCardMedia Image="@GetPosterUrl(_movie)" Height="500" Style="object-fit: cover;" />
                }
                else
                {
                    <div style="height: 450px; background: #2D2D44; display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" Style="color: #666;" />
                    </div>
                }
                <MudCardContent Style="padding: 16px;">
                    <!-- 评分信息 -->
                    @if (_movie.Rating.HasValue)
                    {
                        <div style="display: flex; align-items: center; margin-bottom: 8px;">
                            <MudRating ReadOnly="true" SelectedValue="@((int)(_movie.Rating.Value / 2))" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="color: #FFD700; margin-left: 8px;">
                                @_movie.Rating.Value.ToString("0.0") / 10
                            </MudText>
                            @if (_movie.VoteCount.HasValue)
                            {
                                <MudText Typo="Typo.caption" Style="color: #888; margin-left: 8px;">
                                    (@_movie.VoteCount.Value.ToString("N0") 人评价)
                                </MudText>
                            }
                        </div>
                    }
                    
                    <!-- 快捷操作按钮 -->
                    <MudStack Row="true" Spacing="1" Style="margin-top: 12px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                                   Style="background: #E94560; flex: 1;" Size="Size.Small"
                                   OnClick="@(() => PlayVideo(_movie.FilePath))">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Style="margin-right: 4px;" />
                            播放
                        </MudButton>
                   @*      @if (_movie.IsFavorite)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Favorite">
                                收藏
                            </MudButton>
                        } *@
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- 右侧 - 详细信息 -->
        <MudItem xs="12" md="8">
            <!-- 标题区域 -->
            <MudCard Style="background: #1A1A2E; position: relative; overflow: hidden; border-radius: 8px;opacity: 0.8; margin-bottom: 16px;">
                <MudCardContent Style="position: relative; z-index: 1; padding: 20px;">
                    <MudText Typo="Typo.h4" Style="color: white; font-weight: bold; margin-bottom: 4px;">@_movie.Title</MudText>
                    
                    @if (!string.IsNullOrEmpty(_movie.OriginalTitle) && _movie.OriginalTitle != _movie.Title)
                    {
                        <MudText Typo="Typo.subtitle1" Style="color: #ccc; margin-bottom: 8px;">@_movie.OriginalTitle</MudText>
                    }
                    
                    @if (!string.IsNullOrEmpty(_movie.Tagline))
                    {
                        <MudText Typo="Typo.body2" Style="color: #E94560; font-style: italic; margin-bottom: 12px;">
                            "@_movie.Tagline"
                        </MudText>
                    }

                    <!-- 基础信息标签 -->
                    <MudStack Row="true" Spacing="2" Style="margin-bottom: 12px; flex-wrap: wrap;">
                        @if (_movie.ReleaseDate.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_movie.ReleaseDate.Value.ToString("yyyy-MM-dd")</MudChip>
                        }
                        else if (_movie.ReleaseYear.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_movie.ReleaseYear</MudChip>
                        }
                        @if (_movie.Runtime.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark">@FormatRuntime(_movie.Runtime)</MudChip>
                        }
                        @if (!string.IsNullOrEmpty(_movie.Status))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@_movie.Status</MudChip>
                        }
                        @if (!string.IsNullOrEmpty(_movie.OriginalLanguage))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@GetLanguageName(_movie.OriginalLanguage)</MudChip>
                        }
                        @if (_movie.Popularity.HasValue && _movie.Popularity > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">人气: @_movie.Popularity.Value.ToString("F0")</MudChip>
                        }
                    </MudStack>

                    <!-- 类型标签 -->
                    @if (!string.IsNullOrEmpty(_movie.Genres))
                    {
                        <MudStack Row="true" Spacing="2" Style="margin-bottom: 12px; flex-wrap: wrap;">
                            @foreach (var genre in GetGenresList(_movie.Genres))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@genre</MudChip>
                            }
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>

            <!-- 简介 -->
            @if (!string.IsNullOrEmpty(_movie.Overview))
            {
                <MudCard Style="background: #1A1A2E; border-radius: 8px;opacity: 0.8; margin-bottom: 16px;">
                    <MudCardContent Style="padding: 16px;">
                        <MudText Typo="Typo.subtitle2" Style="color: #E94560; margin-bottom: 8px;">剧情简介</MudText>
                        <MudText Typo="Typo.body2" Style="color: #E0E0E0; line-height: 1.8;">
                            @_movie.Overview
                        </MudText>
                    </MudCardContent>
                </MudCard>
            }

            <!-- 详细信息卡片 -->
            <MudCard Style="background: #1A1A2E; border-radius: 8px;opacity: 0.8; margin-bottom: 16px;">
                <MudCardContent Style="padding: 16px;">
                    <MudText Typo="Typo.subtitle2" Style="color: #E94560; margin-bottom: 12px;">详细信息</MudText>
                    
                    <MudGrid>
                        <!-- 演职人员 -->
                        @if (!string.IsNullOrEmpty(_movie.Director))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">导演</MudText>
                                @RenderDirectorLinks(_movie.Director, _movie.DirectorTmdbId)
                            </MudItem>
                        }
                        
                        @if (!string.IsNullOrEmpty(_movie.Writer))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">编剧</MudText>
                                @RenderWriterLinks(_movie.Writer, _movie.WriterTmdbIds)
                            </MudItem>
                        }

                        <!-- 制片信息 -->
                        @if (!string.IsNullOrEmpty(_movie.Country) || !string.IsNullOrEmpty(_movie.ProductionCountries))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">制片国家/地区</MudText>
                                <MudText Typo="Typo.body2" Style="color: white;">
                                    @(_movie.Country ?? _movie.ProductionCountries)
                                </MudText>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.ProductionCompanies))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">制片公司</MudText>
                                @RenderCompanyLinks(_movie.ProductionCompanies, _movie.ProductionCompanyIds)
                            </MudItem>
                        }

                        <!-- 语言信息 -->
                        @if (!string.IsNullOrEmpty(_movie.Language) || !string.IsNullOrEmpty(_movie.OriginalLanguage))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">语言</MudText>
                                <MudText Typo="Typo.body2" Style="color: white;">
                                    @(_movie.Language ?? GetLanguageName(_movie.OriginalLanguage ?? ""))
                                </MudText>
                            </MudItem>
                        }

                        <!-- IMDB ID -->
                        @if (!string.IsNullOrEmpty(_movie.ImdbId))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">IMDB</MudText>
                                <MudLink Href="@($"https://www.imdb.com/title/{_movie.ImdbId}")" Target="_blank" Style="color: #E94560;">
                                    @_movie.ImdbId
                                </MudLink>
                            </MudItem>
                        }

                        <!-- 所属系列 -->
                        @if (!string.IsNullOrEmpty(_movie.BelongsToCollection))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">所属系列</MudText>
                                <MudText Typo="Typo.body2" Style="color: white;">@_movie.BelongsToCollection</MudText>
                            </MudItem>
                        }

                        <!-- 官方网站 -->
                        @if (!string.IsNullOrEmpty(_movie.Homepage))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">官方网站</MudText>
                                <MudLink Href="@_movie.Homepage" Target="_blank" Style="color: #E94560;">
                                    访问官网
                                </MudLink>
                            </MudItem>
                        }

                        <!-- 财务信息 -->
                        @if (_movie.Budget.HasValue && _movie.Budget > 0)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">制作预算</MudText>
                                <MudText Typo="Typo.body2" Style="color: #4CAF50;">$@_movie.Budget.Value.ToString("N0")</MudText>
                            </MudItem>
                        }

                        @if (_movie.Revenue.HasValue && _movie.Revenue > 0)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">票房收入</MudText>
                                <MudText Typo="Typo.body2" Style="color: #4CAF50;">$@_movie.Revenue.Value.ToString("N0")</MudText>
                            </MudItem>
                        }

                        <!-- 投票和人气 -->
                        @if (_movie.VoteCount.HasValue && _movie.VoteCount > 0)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">投票数</MudText>
                                <MudText Typo="Typo.body2" Style="color: white;">@_movie.VoteCount.Value.ToString("N0")</MudText>
                            </MudItem>
                        }

                        @if (_movie.Popularity.HasValue && _movie.Popularity > 0)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Style="color: #888;">人气指数</MudText>
                                <MudText Typo="Typo.body2" Style="color: white;">@_movie.Popularity.Value.ToString("F0")</MudText>
                            </MudItem>
                        }

                        <!-- 演员 -->
                        @if (!string.IsNullOrEmpty(_movie.Cast))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Style="color: #888;">主演</MudText>
                                @RenderCastLinks(_movie.Cast, _movie.CastTmdbIds)
                            </MudItem>
                        }

                        <!-- 关键词 -->
                        @if (!string.IsNullOrEmpty(_movie.Keywords))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Style="color: #888;">关键词</MudText>
                                <MudText Typo="Typo.body2" Style="color: #ccc;">@GetKeywordsList(_movie.Keywords)</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- 技术规格卡片 -->
            <MudCard Style="background: #1A1A2E; border-radius: 8px;opacity: 0.8; margin-bottom: 16px;">
                <MudCardContent Style="padding: 16px;">
                    <MudText Typo="Typo.subtitle2" Style="color: #E94560; margin-bottom: 12px;">技术规格</MudText>
                    
                    <MudGrid>
                        <!-- 视频信息 -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.VideoSettings" Size="Size.Small" Style="color: #E94560;" />
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color: #888;">视频编码</MudText>
                                        <MudText Typo="Typo.body2" Style="color: white;">@(_movie.VideoCodec ?? "未知")</MudText>
                                    </div>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        @if (!string.IsNullOrEmpty(_movie.Resolution))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.HighQuality" Size="Size.Small" Style="color: #E94560;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">分辨率</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.Resolution</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (_movie.Width.HasValue && _movie.Height.HasValue)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.AspectRatio" Size="Size.Small" Style="color: #E94560;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">画面尺寸</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.Width x @_movie.Height</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (_movie.FrameRate.HasValue)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Style="color: #E94560;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">帧率</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.FrameRate.Value.ToString("F2") fps</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.AspectRatio))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Crop" Size="Size.Small" Style="color: #E94560;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">宽高比</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.AspectRatio</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.HdrType))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.HdrOn" Size="Size.Small" Style="color: #E94560;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">HDR</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.HdrType</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.ColorSpace))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" Style="color: #E94560;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">色彩空间</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.ColorSpace</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.BitDepth))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.ColorLens" Size="Size.Small" Style="color: #E94560;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">色深</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.BitDepth</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        <!-- 音频信息 -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Speaker" Size="Size.Small" Style="color: #4CAF50;" />
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color: #888;">音频编码</MudText>
                                        <MudText Typo="Typo.body2" Style="color: white;">@(_movie.AudioCodec ?? "未知")</MudText>
                                    </div>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        @if (!string.IsNullOrEmpty(_movie.AudioChannels))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.SurroundSound" Size="Size.Small" Style="color: #4CAF50;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">声道</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.AudioChannels</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.AudioLanguages))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Style="color: #4CAF50;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">音频语言</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.AudioLanguages</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.SubtitleFormats))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Subtitles" Size="Size.Small" Style="color: #4CAF50;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">字幕格式</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.SubtitleFormats</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        <!-- 文件信息 -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Style="color: #2196F3;" />
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color: #888;">文件大小</MudText>
                                        <MudText Typo="Typo.body2" Style="color: white;">@FormatFileSize(_movie.FileSize)</MudText>
                                    </div>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        @if (_movie.VideoBitrate.HasValue)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.DataUsage" Size="Size.Small" Style="color: #2196F3;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">视频码率</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@(_movie.VideoBitrate.Value / 1000000) Mbps</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (_movie.AudioBitrate.HasValue)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Style="color: #2196F3;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">音频码率</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@(_movie.AudioBitrate.Value / 1000) Kbps</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }

                        @if (!string.IsNullOrEmpty(_movie.ReleaseGroup))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px;">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Style="color: #9C27B0;" />
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #888;">发布组</MudText>
                                            <MudText Typo="Typo.body2" Style="color: white;">@_movie.ReleaseGroup</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- 外部链接 -->
            @if (!string.IsNullOrEmpty(_movie.Homepage) || !string.IsNullOrEmpty(_movie.TmdbId))
            {
                <MudCard Style="background: #1A1A2E; border-radius: 8px;opacity: 0.8; margin-bottom: 16px;">
                    <MudCardContent Style="padding: 16px;">
                        <MudText Typo="Typo.subtitle2" Style="color: #E94560; margin-bottom: 12px;">外部链接</MudText>
                        <MudStack Row="true" Spacing="2">
                            @if (!string.IsNullOrEmpty(_movie.TmdbId))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           Href="@($"https://www.themoviedb.org/movie/{_movie.TmdbId}")" Target="_blank">
                                    <MudIcon Icon="@Icons.Material.Filled.Movie" Style="margin-right: 4px;" />
                                    TMDB
                                </MudButton>
                            }
                            @if (!string.IsNullOrEmpty(_movie.ImdbId))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                           Href="@($"https://www.imdb.com/title/{_movie.ImdbId}")" Target="_blank">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Style="margin-right: 4px;" />
                                    IMDb
                                </MudButton>
                            }
                            @if (!string.IsNullOrEmpty(_movie.Homepage))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           Href="@_movie.Homepage" Target="_blank">
                                    <MudIcon Icon="@Icons.Material.Filled.Home" Style="margin-right: 4px;" />
                                    官网
                                </MudButton>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>
    </MudGrid>

    <!-- 视频文件列表 -->
    <MudCard Style="background: #1A1A2E;position: relative;overflow: hidden; z-index: 2; margin-top: 20px; border-radius: 8px;opacity: 0.8">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Style="color: #E94560;">
                    @(_isTvShow ? "剧集列表" : "视频文件")
                </MudText>
                <MudText Typo="Typo.body2" Style="color: gray;">
                    共 @_videoFiles.Count 个视频
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                @foreach (var (video, index) in _videoFiles.Select((v, i) => (v, i)))
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudPaper Style="background: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; cursor: pointer;" @onclick="() => PlayVideo(video)">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #E94560, #FF6B6B); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" Style="color: white;" />
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <MudText Typo="Typo.body1" Style="color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @(_isTvShow ? $"第 {index + 1} 集" : Path.GetFileNameWithoutExtension(video))
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="color: gray; font-size: 11px;">
                                        @Path.GetFileName(video)
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

