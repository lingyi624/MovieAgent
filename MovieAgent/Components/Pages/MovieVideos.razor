        PlayerService.ToggleFullscreen();
    }

    private string FormatRuntime(int? runtime)
    {
        if (!runtime.HasValue) return "未知时长";
        int hours = runtime.Value / 60;
        int minutes = runtime.Value % 60;
        if (hours > 0)
            return $"{hours}h{minutes}m";
        return $"{minutes}分钟";
    }

    private string FormatFileSize(long fileSize)
    {
        if (fileSize < 1024) return $"{fileSize} B";
        if (fileSize < 1024 * 1024) return $"{(fileSize / 1024.0):F1} KB";
        if (fileSize < 1024 * 1024 * 1024) return $"{(fileSize / (1024.0 * 1024)):F1} MB";
        return $"{(fileSize / (1024.0 * 1024 * 1024)):F2} GB";
    }

    private string GetPosterUrl(Movie movie)
    {
        if (!string.IsNullOrWhiteSpace(movie.PosterPath))
        {
            if (movie.PosterPath.StartsWith("http"))
                return movie.PosterPath;
            return $"https://image.tmdb.org/t/p/w500{movie.PosterPath}";
        }
        return "https://via.placeholder.com/500x750?text=No+Poster";
    }

    private List<string> GetGenresList(string? genres)
    {
        if (string.IsNullOrEmpty(genres)) return new List<string>();
        
        // 尝试解析 JSON 数组
        try
        {
            var result = System.Text.Json.JsonSerializer.Deserialize<List<string>>(genres);
            if (result != null) return result;
        }
        catch { }
        
        // 如果不是 JSON，按逗号分隔
        return genres.Split(',', StringSplitOptions.RemoveEmptyEntries)
                     .Select(g => g.Trim())
                     .ToList();
    }

    private string GetLanguageName(string? code)
    {
        if (string.IsNullOrEmpty(code)) return "";
        
        var languageMap = new Dictionary<string, string>
        {
            { "en", "英语" }, { "zh", "中文" }, { "ja", "日语" },
            { "ko", "韩语" }, { "fr", "法语" }, { "de", "德语" },
            { "it", "意大利语" }, { "es", "西班牙语" }, { "ru", "俄语" },
            { "hi", "印地语" }, { "th", "泰语" }, { "pt", "葡萄牙语" }
        };
        
        return languageMap.TryGetValue(code.ToLower(), out var name) ? name : code.ToUpper();
    }

    private string GetCompaniesList(string? companies)
    {
        if (string.IsNullOrEmpty(companies)) return "";
        
        // 尝试解析 JSON 数组
        try
        {
            var result = System.Text.Json.JsonSerializer.Deserialize<List<string>>(companies);
            if (result != null && result.Any())
                return string.Join("、", result.Take(3));
        }
        catch { }
        
        return companies;
    }

    private string GetKeywordsList(string? keywords)
    {
        if (string.IsNullOrEmpty(keywords)) return "";
        
        // 尝试解析 JSON 数组
        try
        {
            var result = System.Text.Json.JsonSerializer.Deserialize<List<string>>(keywords);
            if (result != null && result.Any())
                return string.Join("、", result.Take(10));
        }
        catch { }
        
        return keywords;
    }

