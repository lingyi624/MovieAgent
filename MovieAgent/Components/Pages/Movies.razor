    private async Task SaveTitle()
    {
        if (_editingMovie == null || string.IsNullOrWhiteSpace(_editTitle))
            return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            _editingMovie.Title = _editTitle;

            var tmdbInfo = await TmdbService.SearchMovieAsync(_editTitle, _editingMovie.ReleaseYear);
            if (tmdbInfo != null)
            {
                // 保存用户数据
                var userRating = _editingMovie.UserRating;
                var isFavorite = _editingMovie.IsFavorite;
                var isWatched = _editingMovie.IsWatched;
                var watchedAt = _editingMovie.WatchedAt;
                var playbackPosition = _editingMovie.PlaybackPosition;
                var tags = _editingMovie.Tags;
                var createdAt = _editingMovie.CreatedAt;

                // 基本信息
                _editingMovie.TmdbId = tmdbInfo.Id.ToString();
                _editingMovie.Title = tmdbInfo.Title;
                _editingMovie.OriginalTitle = tmdbInfo.OriginalTitle;
                _editingMovie.Overview = tmdbInfo.Overview;
                _editingMovie.Tagline = tmdbInfo.Tagline;
                _editingMovie.PosterPath = tmdbInfo.PosterPath;
                _editingMovie.BackdropPath = tmdbInfo.BackdropPath;
                _editingMovie.ReleaseDate = tmdbInfo.ReleaseDate;
                if (tmdbInfo.ReleaseYear.HasValue)
                    _editingMovie.ReleaseYear = tmdbInfo.ReleaseYear;

                // 评分和人气
                if (tmdbInfo.Rating.HasValue)
                    _editingMovie.Rating = tmdbInfo.Rating.Value;
                if (tmdbInfo.VoteCount.HasValue)
                    _editingMovie.VoteCount = tmdbInfo.VoteCount;
                if (tmdbInfo.Popularity.HasValue)
                    _editingMovie.Popularity = tmdbInfo.Popularity;

                // 内容信息
                if (tmdbInfo.Runtime.HasValue)
                    _editingMovie.Runtime = tmdbInfo.Runtime;
                if (tmdbInfo.Genres.Any())
                    _editingMovie.Genres = System.Text.Json.JsonSerializer.Serialize(tmdbInfo.Genres);
                _editingMovie.Homepage = tmdbInfo.Homepage;
                _editingMovie.Status = tmdbInfo.Status;
                _editingMovie.IsAdult = tmdbInfo.IsAdult;
                _editingMovie.BelongsToCollection = tmdbInfo.BelongsToCollection;

                // 财务信息
                if (tmdbInfo.Budget.HasValue)
                    _editingMovie.Budget = tmdbInfo.Budget;
                if (tmdbInfo.Revenue.HasValue)
                    _editingMovie.Revenue = tmdbInfo.Revenue;

                // 语言制片
                _editingMovie.OriginalLanguage = tmdbInfo.OriginalLanguage;
                if (tmdbInfo.ProductionCompanies.Any())
                    _editingMovie.ProductionCompanies = System.Text.Json.JsonSerializer.Serialize(tmdbInfo.ProductionCompanies);
                if (tmdbInfo.Countries.Any())
                    _editingMovie.ProductionCountries = System.Text.Json.JsonSerializer.Serialize(tmdbInfo.Countries);
                if (tmdbInfo.Countries.Any())
                    _editingMovie.OriginCountry = string.Join(", ", tmdbInfo.Countries);
                if (tmdbInfo.Keywords.Any())
                    _editingMovie.Keywords = System.Text.Json.JsonSerializer.Serialize(tmdbInfo.Keywords);

                // 演职人员
                _editingMovie.Director = tmdbInfo.Director;
                _editingMovie.Writer = tmdbInfo.Writer;
                _editingMovie.Cast = tmdbInfo.Cast;
                _editingMovie.DirectorTmdbId = tmdbInfo.DirectorTmdbId;
                _editingMovie.WriterTmdbIds = System.Text.Json.JsonSerializer.Serialize(tmdbInfo.WriterTmdbIds ?? new List<string>());
                _editingMovie.CastTmdbIds = System.Text.Json.JsonSerializer.Serialize(tmdbInfo.CastTmdbIds ?? new List<string>());
                if (tmdbInfo.Languages.Any())
                    _editingMovie.Language = string.Join(", ", tmdbInfo.Languages);
                if (tmdbInfo.Countries.Any())
                    _editingMovie.Country = string.Join(", ", tmdbInfo.Countries);

                // 制片公司ID
                _editingMovie.ProductionCompanyIds = System.Text.Json.JsonSerializer.Serialize(tmdbInfo.ProductionCompanyIds ?? new List<string>());

                // 标识
                _editingMovie.ImdbId = tmdbInfo.ImdbId;

                // 恢复用户数据
                _editingMovie.UserRating = userRating;
                _editingMovie.IsFavorite = isFavorite;
                _editingMovie.IsWatched = isWatched;
                _editingMovie.WatchedAt = watchedAt;
                _editingMovie.PlaybackPosition = playbackPosition;
                _editingMovie.Tags = tags;
                _editingMovie.CreatedAt = createdAt;
                _editingMovie.UpdatedAt = DateTime.UtcNow;
                var text = BuildEmbeddingText(_editingMovie);
                if (!string.IsNullOrWhiteSpace(text))
                {
                    _editingMovie.EmbeddingText = text;
                    _editingMovie.EmbeddingAt = DateTime.UtcNow;
                }
                // 使用统一更新服务，同步向量数据库
                await MovieUpdateService.UpdateMovieWithVectorAsync(_editingMovie);
            }
            else
            {
                await MovieRepo.UpdatePosterFromDirectoryAsync(_editingMovie);
                await MovieRepo.UpdateMediaInfoFromDirectoryAsync(_editingMovie);
                
                // 使用统一更新服务，同步向量数据库
                await MovieUpdateService.UpdateMovieWithVectorAsync(_editingMovie);
            }

            await LoadMovies();
            CloseEditDialog();
        }
        catch (Exception ex)
        {
            Logger.Error(ex, "保存标题失败");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

