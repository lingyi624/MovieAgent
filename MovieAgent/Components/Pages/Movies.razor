@page "/movies"
@inject IMovieRepository MovieRepo
@inject ITagService TagService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>电影库</PageTitle>

<MudText Typo="Typo.h4" GutterBottom Style="color: #E94560;">电影库</MudText>

@if (!string.IsNullOrEmpty(_activeTag))
{
    <MudAlert Severity="Severity.Info" Style="margin-bottom: 16px;" 
              ShowCloseIcon="true" CloseIconClicked="ClearTagFilter">
        <MudText>当前筛选标签: <strong style="color: #E94560;">@_activeTag</strong> (共 @_totalCount 部电影)</MudText>
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField @bind-Value="_searchTerm" @bind-Value:after="OnSearchChanged" Label="搜索" Variant="Variant.Outlined" Immediate="true"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      DebounceInterval="300" />
    </MudItem>
    <MudItem xs="6" sm="3" md="2">
        <MudSelect @bind-Value="_sortBy" Label="排序" Variant="Variant.Outlined" T="string">
            <MudSelectItem T="string" Value="@("created")">添加时间</MudSelectItem>
            <MudSelectItem T="string" Value="@("title")">标题</MudSelectItem>
            <MudSelectItem T="string" Value="@("year")">年份</MudSelectItem>
            <MudSelectItem T="string" Value="@("rating")">评分</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="6" sm="3" md="2">
        <MudSwitch @bind-Value="_sortDesc" Label="降序" Color="Color.Primary" />
    </MudItem>
</MudGrid>

<div @ref="_scrollContainer" id="movie-list-container" style="height: calc(100vh - 250px); overflow-y: auto;" @onscroll="OnScroll">
    <MudTable Items="_movies" Hover="true" Striped="true" Elevation="2" Style="background: #2D2D44;">
        <HeaderContent>
            <MudTh Style="color: #E94560; font-weight: bold;">海报</MudTh>
            <MudTh Style="color: #E94560; font-weight: bold;">标题</MudTh>
            <MudTh Style="color: #E94560; font-weight: bold;">年份</MudTh>
            <MudTh Style="color: #E94560; font-weight: bold;">分辨率</MudTh>
            <MudTh Style="color: #E94560; font-weight: bold;">评分</MudTh>
            <MudTh Style="color: #E94560; font-weight: bold;">状态</MudTh>
            <MudTh Style="color: #E94560; font-weight: bold;">操作</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudImage Src="@GetPosterUrl(context)" Height="60" Width="40" ObjectFit="ObjectFit.Cover" />
            </MudTd>
            <MudTd>
                <MudText Style="font-weight: bold; color: #E0E0E0;">@context.Title</MudText>
                @if (!string.IsNullOrEmpty(context.OriginalTitle) && context.OriginalTitle != context.Title)
                {
                    <MudText Typo="Typo.caption" Style="color: #888888;">@context.OriginalTitle</MudText>
                }
            </MudTd>
            <MudTd Style="color: #CCCCCC;">@(context.ReleaseYear?.ToString() ?? "-")</MudTd>
            <MudTd>
                @if (!string.IsNullOrEmpty(context.Resolution))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Resolution</MudChip>
                }
            </MudTd>
            <MudTd Style="color: #E0E0E0;">
                @if (context.Rating.HasValue)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #FFD700;" />
                    @context.Rating.Value.ToString("0.0")
                }
            </MudTd>
            <MudTd Style="color: #E0E0E0;">
                @if (context.IsWatched)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">已看</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">未看</MudChip>
                }
                @if (context.IsFavorite)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="margin-left: 4px;">收藏</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" OnClick="() => PlayMovie(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Secondary" OnClick="() => GoToDetail(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    <div style="padding: 16px; text-align: center;">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
            <MudText Style="color: #888; margin-left: 8px;">加载中...</MudText>
        }
        else if (!_hasMore)
        {
            <MudText Style="color: #888;">- 已加载全部 @_movies.Count 部影片 -</MudText>
        }
    </div>
</div>

@code {
    private List<Movie> _movies = new();
    private string _searchTerm = "";
    private string _sortBy = "created";
    private bool _sortDesc = true;
    private int _currentPage = 1;
    private int _pageSize = 20;
    private int _totalCount = 0;
    private bool _isLoading = false;
    private bool _hasMore = true;
    private ElementReference _scrollContainer;
    private string? _activeTag;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = ParseQueryString(uri.Query);
        if (query.TryGetValue("tag", out var tag))
        {
            _activeTag = tag;
        }
        if (query.TryGetValue("search", out var search))
        {
            _searchTerm = search;
        }
    }

    private static Dictionary<string, string> ParseQueryString(string query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query) || query == "?")
            return result;

        var queryPart = query.TrimStart('?');
        foreach (var pair in queryPart.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=');
            if (parts.Length == 2)
            {
                var key = Uri.UnescapeDataString(parts[0]);
                var value = Uri.UnescapeDataString(parts[1]);
                result[key] = value;
            }
        }
        return result;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadMovies(true);
    }

    private async Task ClearTagFilter()
    {
        _activeTag = null;
        NavigationManager.NavigateTo("/movies");
    }

    private async Task LoadMovies(bool resetPage = false)
    {
        if (resetPage)
        {
            _currentPage = 1;
            _movies.Clear();
            _hasMore = true;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            List<Movie> movies;
            
            if (!string.IsNullOrEmpty(_activeTag))
            {
                // 标签筛选：使用 TagService 获取该标签下的所有电影 ID
                var allMovies = await MovieRepo.GetAllAsync();
                var taggedMovieIds = new List<int>();
                foreach (var m in allMovies)
                {
                    var tags = await TagService.GetTagsAsync(m.Id);
                    if (tags.Any(t => t.Equals(_activeTag, StringComparison.OrdinalIgnoreCase)))
                    {
                        taggedMovieIds.Add(m.Id);
                    }
                }
                movies = allMovies.Where(m => taggedMovieIds.Contains(m.Id))
                                  .Skip((_currentPage - 1) * _pageSize)
                                  .Take(_pageSize)
                                  .ToList();
                _totalCount = taggedMovieIds.Count;
            }
            else
            {
                var filter = new MovieFilter
                {
                    SearchKeyword = _searchTerm,
                    SortBy = _sortBy,
                    SortDescending = _sortDesc,
                    Page = _currentPage,
                    PageSize = _pageSize
                };
                movies = await MovieRepo.GetAllAsync(filter);
                _totalCount = await MovieRepo.GetCountAsync(new MovieFilter { SearchKeyword = _searchTerm });
            }
            
            if (movies.Count < _pageSize)
            {
                _hasMore = false;
            }

            _movies.AddRange(movies);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMore()
    {
        if (_isLoading || !_hasMore) return;
        
        _currentPage++;
        await LoadMovies();
    }

    private async Task OnScroll()
    {
        if (_isLoading || !_hasMore) return;

        try
        {
            var scrollTop = await JSRuntime.InvokeAsync<double>("eval", 
                "document.getElementById('movie-list-container')?.scrollTop ?? 0");
            var scrollHeight = await JSRuntime.InvokeAsync<double>("eval", 
                "document.getElementById('movie-list-container')?.scrollHeight ?? 0");
            var clientHeight = await JSRuntime.InvokeAsync<double>("eval", 
                "document.getElementById('movie-list-container')?.clientHeight ?? 0");

            // 当滚动到距离底部 100px 时自动加载
            if (scrollTop + clientHeight >= scrollHeight - 100)
            {
                await LoadMore();
            }
        }
        catch
        {
            // 忽略 JS 错误
        }
    }

    private async Task OnSearchChanged()
    {
        await LoadMovies(true);
    }

    private string GetPosterUrl(Movie movie)
    {
        if (!string.IsNullOrWhiteSpace(movie.PosterPath))
            return $"https://image.tmdb.org/t/p/w92{movie.PosterPath}";
        return "images/placeholder-poster.png";
    }

    private void PlayMovie(Movie movie)
    {
        NavigationManager.NavigateTo($"/play/{movie.Id}");
    }

    private void GoToDetail(Movie movie) => NavigationManager.NavigateTo($"/movie/{movie.Id}");
}
