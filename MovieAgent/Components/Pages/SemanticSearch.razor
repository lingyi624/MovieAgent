@page "/semantic-search"
@inject IMovieRepository MovieRepo
@inject IVectorDatabaseService VectorDb
@inject IHybridSearchService HybridSearch
@inject IPlayerService PlayerService
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>语义搜索</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Style="padding: 16px;">
    <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 24px; border-radius: 12px; margin-bottom: 16px;">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h4" Style="color: #E94560;">语义搜索</MudText>
                <MudChip T="string" Color="Color.Primary">向量库: @_totalRecords / @_totalMovies</MudChip>
            </MudStack>

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Stretch">
                <MudTextField @ref="_searchRef" @bind-Value="_searchText" Label="自然语言描述你想看的电影" FullWidth
                              Variant="Variant.Outlined" Style="flex: 1;"
                              HelperText="例如：关于太空冒险的科幻片、悬疑推理、温暖的治愈系电影..."
                              HelperTextOnFocus="true"
                              OnKeyUp="OnKeyUpHandler" Immediate="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DoSearch" Disabled="@_isSearching"
                           Style="background:#E94560; min-width: 120px;" StartIcon="@Icons.Material.Filled.Search">
                    @(_isSearching ? "搜索中..." : "搜索")
                </MudButton>
            </MudStack>

            <MudStack Row="true" Spacing="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BuildIndex"
                           Disabled="@_isBuilding" StartIcon="@Icons.Material.Filled.Build"
                           Style="background:#E94560;">
                    @(_isBuilding ? $"生成向量中... ({_builtCount}/{_totalToBuild})" : "构建向量索引")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="RebuildIndex"
                           Disabled="@_isBuilding" StartIcon="@Icons.Material.Filled.Refresh"
                           Style="background:#FF9800; color:white;">
                    重新构建所有向量
                </MudButton>
                @if (_isBuilding)
                {
                    <MudProgressLinear Color="Color.Primary" Style="width: 200px; align-self: center;" />
                    <MudText Typo="Typo.caption" Style="color: #FF9800; align-self: center;">正在生成向量，请稍候...</MudText>
                }
            </MudStack>

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Style="color: #888;">搜索模式:</MudText>
                <MudButtonGroup Size="Size.Small">
                    <MudButton Variant="_searchMode == SearchMode.Hybrid ? Variant.Filled : Variant.Outlined"
                               Color="Color.Primary" Style="@(_searchMode == SearchMode.Hybrid ? "color:red;" : "color:white;")"
                               OnClick="() => _searchMode = SearchMode.Hybrid">
                        混合检索
                    </MudButton>
                    <MudButton Variant="_searchMode == SearchMode.Vector ? Variant.Filled : Variant.Outlined" 
                               Color="Color.Primary" Style="@(_searchMode == SearchMode.Vector ? "color:red;" : "color:white;")"
                               OnClick="() => _searchMode = SearchMode.Vector">
                        向量检索
                    </MudButton>
                    <MudButton Variant="_searchMode == SearchMode.Keyword ? Variant.Filled : Variant.Outlined" 
                               Color="Color.Primary" Style="@(_searchMode == SearchMode.Keyword ? "color:red;" : "color:white;")"
                               OnClick="() => _searchMode = SearchMode.Keyword">
                        关键词检索
                    </MudButton>
                </MudButtonGroup>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_isSearching)
    {
        <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 32px; border-radius: 12px; text-align: center;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Style="color: #E0E0E0; margin-top: 12px;">正在搜索电影...</MudText>
        </MudPaper>
    }
    else if (_searchResults != null && _searchResults.Any())
    {
        <MudText Typo="Typo.h6" Style="color: #E0E0E0; margin-bottom: 16px;">找到 @_searchResults.Count 部电影</MudText>
        <MudGrid>
            @foreach (var movie in _searchResults)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Style="background: #2D2D44; border-radius: 12px; overflow: hidden; cursor: pointer;"
                             @onclick="() => GoToDetail(movie.Id)">
                        <MudCardContent Style="padding: 16px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="margin-bottom: 8px;">
                                <MudText Style="color: #E94560; font-weight: bold; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@movie.Title</MudText>
                                @if (_searchMode != SearchMode.Keyword)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@string.Format("{0:0.0}", movie.Rating)</MudChip>
                                }
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(movie.Overview))
                            {
                                <MudText Typo="Typo.body2" Style="color: #B0B0C0;">
                                    @movie.Overview.Substring(0, Math.Min(120, movie.Overview.Length))...
                                </MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(movie.Resolution))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Style="margin-top: 8px;">@movie.Resolution</MudChip>
                            }
                        </MudCardContent>
                        <MudCardActions Style="padding: 8px 16px 16px 16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       Style="background:#E94560;" OnClick="(e => PlayMovie(movie.Id))">
                                播放
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                                       OnClick="(e => GoToDetail(movie.Id))">
                                详情
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else if (!string.IsNullOrWhiteSpace(_searchText) && !_isSearching)
    {
        <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 24px; border-radius: 12px; text-align: center;">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Secondary" Size="Size.Large" />
            <MudText Style="color: #E0E0E0; margin-top: 12px;">没有找到相关电影</MudText>
            <MudText Typo="Typo.body2" Style="color: gray;">请尝试其他描述，或先构建向量索引</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Style="background: #1A1A2E; padding: 24px; border-radius: 12px;">
            <MudText Style="color: #E0E0E0;">
                欢迎使用语义搜索！
            </MudText>
            <MudList T="string" Style="color: #B0B0C0;">
                <MudListItem T="string" Icon="@Icons.Material.Filled.Star">
                    输入自然语言描述，如「关于太空冒险的科幻片」
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Star">
                    支持三种搜索模式：混合检索、向量检索、关键词检索
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Star">
                    首次使用请点击「构建向量索引」
                </MudListItem>
            </MudList>
        </MudPaper>
    }
</MudContainer>

@code {
    private enum SearchMode
    {
        Hybrid,
        Vector,
        Keyword
    }

    private string _searchText = string.Empty;
    private bool _isSearching;
    private bool _isBuilding;
    private int _builtCount;
    private int _totalToBuild;
    private int _totalRecords;
    private int _totalMovies;
    private List<Movie>? _searchResults;
    private MudTextField<string>? _searchRef;
    private SearchMode _searchMode = SearchMode.Hybrid;

    protected override async Task OnInitializedAsync()
    {
        await VectorDb.EnsureDatabaseAsync();
        _totalRecords = await VectorDb.GetRecordCountAsync();
        var movies = await MovieRepo.GetAllAsync();
        _totalMovies = movies.Count;
    }

    private async Task OnKeyUpHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch();
    }

    private async Task DoSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchText) || _isSearching) return;

        _isSearching = true;
        _searchResults = null;
        StateHasChanged();

        try
        {
            switch (_searchMode)
            {
                case SearchMode.Hybrid:
                    _searchResults = await HybridSearch.SearchAsync(_searchText, topK: 12);
                    break;
                case SearchMode.Vector:
                    _searchResults = await SearchVectorWithKeywordSplit(_searchText, 12);
                    break;
                case SearchMode.Keyword:
                    _searchResults = await SearchKeywordWithSplit(_searchText);
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SemanticSearch] 搜索失败: {ex.Message}");
            _searchResults = new List<Movie>();
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 向量检索 - 支持关键词拆分
    /// </summary>
    private async Task<List<Movie>> SearchVectorWithKeywordSplit(string query, int topK)
    {
        var keywords = SplitKeywords(query);
        
        if (keywords.Count > 1)
        {
            Console.WriteLine($"[SemanticSearch] Vector search split '{query}' into {keywords.Count} keywords");
            var allVectorResults = new List<VectorSearchResult>();
            
            foreach (var keyword in keywords)
            {
                var results = await VectorDb.SearchAsync(keyword, topK * 2);
                allVectorResults.AddRange(results);
            }
            
            // 按相似度排序并去重
            var sortedResults = allVectorResults
                .GroupBy(r => r.MovieId)
                .Select(g => g.OrderByDescending(r => r.Similarity).First())
                .OrderByDescending(r => r.Similarity)
                .Take(topK)
                .ToList();
            
            var movieIds1 = sortedResults.Select(r => r.MovieId).ToList();
            var allMovies1 = await MovieRepo.GetAllAsync();
            
            return movieIds1
                .Join(allMovies1, id => id, movie => movie.Id, (id, movie) => movie)
                .Distinct()
                .ToList();
        }
        
        var vectorResults = await VectorDb.SearchAsync(query, topK);
        var movieIds = vectorResults.Select(r => r.MovieId).ToList();
        var allMovies = await MovieRepo.GetAllAsync();
        
        return movieIds
            .Join(allMovies, id => id, movie => movie.Id, (id, movie) => movie)
            .Distinct()
            .ToList();
    }

    /// <summary>
    /// 关键词检索 - 支持关键词拆分
    /// </summary>
    private async Task<List<Movie>> SearchKeywordWithSplit(string query)
    {
        var keywords = SplitKeywords(query);
        
        if (keywords.Count > 1)
        {
            Console.WriteLine($"[SemanticSearch] Keyword search split '{query}' into {keywords.Count} keywords");
            var allResults = new List<Movie>();
            
            foreach (var keyword in keywords)
            {
                var results = await MovieRepo.SearchAsync(keyword);
                allResults.AddRange(results);
            }
            
            // 去重并保持首次出现顺序
            return allResults
                .GroupBy(m => m.Id)
                .Select(g => g.First())
                .ToList();
        }
        
        return await MovieRepo.SearchAsync(query);
    }

    /// <summary>
    /// 拆分关键词 - 支持多种分隔符
    /// </summary>
    private List<string> SplitKeywords(string query)
    {
        char[] separators = { ' ', ',', '，', '、', ';', '；', '|', '\\', '/', '\t' };
        return query.Split(separators, StringSplitOptions.RemoveEmptyEntries)
                    .Select(k => k.Trim())
                    .Where(k => !string.IsNullOrWhiteSpace(k))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
    }

    private async Task BuildIndex()
    {
        if (_isBuilding) return;

        var movies = await MovieRepo.GetAllAsync();
        var toProcess = new List<Movie>();
        foreach (var m in movies)
        {
            if (!await VectorDb.HasMovieAsync(m.Id))
            {
                toProcess.Add(m);
            }
        }

        if (!toProcess.Any()) return;

        _isBuilding = true;
        _builtCount = 0;
        _totalToBuild = toProcess.Count;
        StateHasChanged();

        try
        {
            foreach (var m in toProcess)
            {
                try
                {
                    var text = BuildEmbeddingText(m);
                    var vector = await VectorDb.GenerateEmbeddingAsync(text);
                    if (vector != null && vector.Length > 0)
                    {
                        await VectorDb.AddMovieAsync(m.Id, vector, m.Title, m.Overview);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[SemanticSearch] 处理电影 {m.Id} 失败: {ex.Message}");
                }

                _builtCount++;
                _totalRecords = await VectorDb.GetRecordCountAsync();
                StateHasChanged();
            }
        }
        finally
        {
            _isBuilding = false;
            _totalRecords = await VectorDb.GetRecordCountAsync();
            StateHasChanged();
        }
    }
    private string BuildEmbeddingText(Movie movie)
    {
        var parts = new List<string>();

        // 基本信息 - 使用中文标签
        if (!string.IsNullOrWhiteSpace(movie.Title))
            parts.Add($"电影标题：{movie.Title}");

        if (!string.IsNullOrWhiteSpace(movie.OriginalTitle))
            parts.Add($"原名：{movie.OriginalTitle}");

        if (!string.IsNullOrWhiteSpace(movie.Tagline))
            parts.Add($"标语：{movie.Tagline}");

        // 上映信息
        if (movie.ReleaseDate.HasValue)
            parts.Add($"上映日期：{movie.ReleaseDate.Value:yyyy年MM月dd日}");

        if (movie.ReleaseYear.HasValue)
            parts.Add($"上映年份：{movie.ReleaseYear.Value}年");

        if (!string.IsNullOrWhiteSpace(movie.Status))
            parts.Add($"状态：{movie.Status}");

        // 制片信息
        if (!string.IsNullOrWhiteSpace(movie.ProductionCompanies))
            parts.Add($"制片公司：{ParseJsonList(movie.ProductionCompanies)}");

        if (!string.IsNullOrWhiteSpace(movie.ProductionCountries))
            parts.Add($"制片国家：{ParseJsonList(movie.ProductionCountries)}");

        if (!string.IsNullOrWhiteSpace(movie.OriginCountry))
            parts.Add($"原产国：{movie.OriginCountry}");

        if (!string.IsNullOrWhiteSpace(movie.Country))
            parts.Add($"国家：{movie.Country}");

        // 财务信息
        if (movie.Budget.HasValue && movie.Budget > 0)
            parts.Add($"预算：{movie.Budget.Value:N0}美元");

        if (movie.Revenue.HasValue && movie.Revenue > 0)
            parts.Add($"票房：{movie.Revenue.Value:N0}美元");

        // 语言信息
        if (!string.IsNullOrWhiteSpace(movie.OriginalLanguage))
            parts.Add($"原始语言：{GetLanguageName(movie.OriginalLanguage)}");

        if (!string.IsNullOrWhiteSpace(movie.Language))
            parts.Add($"语言：{movie.Language}");

        if (!string.IsNullOrWhiteSpace(movie.AudioLanguages))
            parts.Add($"音频语言：{movie.AudioLanguages}");

        // 类型和关键词
        if (!string.IsNullOrWhiteSpace(movie.Genres))
            parts.Add($"类型：{ParseJsonList(movie.Genres)}");

        if (!string.IsNullOrWhiteSpace(movie.Keywords))
            parts.Add($"关键词：{ParseJsonList(movie.Keywords)}");

        if (!string.IsNullOrWhiteSpace(movie.AlternativeTitles))
            parts.Add($"别名：{movie.AlternativeTitles}");

        // 演职人员
        if (!string.IsNullOrWhiteSpace(movie.Director))
            parts.Add($"导演：{movie.Director}");

        if (!string.IsNullOrWhiteSpace(movie.Writer))
            parts.Add($"编剧：{movie.Writer}");

        if (!string.IsNullOrWhiteSpace(movie.Cast))
            parts.Add($"演员：{movie.Cast}");

        // 视频技术信息
        if (!string.IsNullOrWhiteSpace(movie.VideoCodec))
            parts.Add($"视频编码：{movie.VideoCodec}");

        if (!string.IsNullOrWhiteSpace(movie.Resolution))
            parts.Add($"分辨率：{movie.Resolution}");

        if (movie.Width.HasValue && movie.Height.HasValue)
            parts.Add($"尺寸：{movie.Width}x{movie.Height}");

        if (movie.FrameRate.HasValue)
            parts.Add($"帧率：{movie.FrameRate}");

        if (!string.IsNullOrWhiteSpace(movie.AspectRatio))
            parts.Add($"画幅比例：{movie.AspectRatio}");

        if (!string.IsNullOrWhiteSpace(movie.HdrType))
            parts.Add($"HDR类型：{movie.HdrType}");

        if (!string.IsNullOrWhiteSpace(movie.ColorSpace))
            parts.Add($"色彩空间：{movie.ColorSpace}");

        if (!string.IsNullOrWhiteSpace(movie.BitDepth))
            parts.Add($"位深：{movie.BitDepth}");

        // 音频技术信息
        if (!string.IsNullOrWhiteSpace(movie.AudioCodec))
            parts.Add($"音频编码：{movie.AudioCodec}");

        if (!string.IsNullOrWhiteSpace(movie.AudioChannels))
            parts.Add($"音频声道：{movie.AudioChannels}");

        if (!string.IsNullOrWhiteSpace(movie.SubtitleFormats))
            parts.Add($"字幕格式：{movie.SubtitleFormats}");

        // 评分和收藏
        if (movie.Rating.HasValue)
            parts.Add($"评分：{movie.Rating:F1}分");

        if (movie.VoteCount.HasValue)
            parts.Add($"投票数：{movie.VoteCount.Value:N0}");

        if (movie.Popularity.HasValue)
            parts.Add($"人气：{movie.Popularity:F1}");

        if (movie.Runtime.HasValue)
        {
            var hours = movie.Runtime.Value / 60;
            var minutes = movie.Runtime.Value % 60;
            var runtimeStr = hours > 0 ? $"{hours}小时{minutes}分钟" : $"{minutes}分钟";
            parts.Add($"时长：{runtimeStr}");
        }

        // 简介
        if (!string.IsNullOrWhiteSpace(movie.Overview))
            parts.Add($"简介：{movie.Overview}");

        return string.Join("。", parts);
    }
    private string ParseJsonList(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "";

        try
        {
            var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json);
            return list != null && list.Any() ? string.Join("、", list) : json;
        }
        catch
        {
            return json;
        }
    }

    private string GetLanguageName(string code)
    {
        var languageMap = new Dictionary<string, string>
        {
            { "en", "英语" }, { "zh", "中文" }, { "ja", "日语" },
            { "ko", "韩语" }, { "fr", "法语" }, { "de", "德语" },
            { "it", "意大利语" }, { "es", "西班牙语" }, { "ru", "俄语" },
            { "hi", "印地语" }, { "th", "泰语" }, { "pt", "葡萄牙语" }
        };

        return languageMap.TryGetValue(code.ToLower(), out var name) ? name : code.ToUpper();
    }
    private async Task RebuildIndex()
    {
        if (_isBuilding) return;

        var movies = await MovieRepo.GetAllAsync();
        if (!movies.Any()) return;

        _isBuilding = true;
        _builtCount = 0;
        _totalToBuild = movies.Count;
        StateHasChanged();

        try
        {
            foreach (var m in movies)
            {
                try
                {
                    var text = BuildEmbeddingText(m);
                    var vector = await VectorDb.GenerateEmbeddingAsync(text);
                    if (vector != null && vector.Length > 0)
                    {
                        await VectorDb.AddMovieAsync(m.Id, vector, m.Title, m.Overview);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[SemanticSearch] 重建电影 {m.Id} 失败: {ex.Message}");
                }

                _builtCount++;
                _totalRecords = await VectorDb.GetRecordCountAsync();
                StateHasChanged();
            }
        }
        finally
        {
            _isBuilding = false;
            _totalRecords = await VectorDb.GetRecordCountAsync();
            StateHasChanged();
        }
    }

    private void GoToDetail(int movieId)
    {
        NavigationManager.NavigateTo($"/movie/{movieId}");
    }

    private async Task PlayMovie(int movieId)
    {
        NavigationManager.NavigateTo($"/movie/{movieId}/videos");

        // var movie = await MovieRepo.GetByIdAsync(movieId);
        // if (movie == null) return;
        // try
        // {
        //     await PlayerService.PlayAsync(movie.FilePath);
        // }
        // catch (Exception ex)
        // {
        //     Console.WriteLine($"[SemanticSearch] 播放失败: {ex.Message}");
        // }
    }

    public async ValueTask DisposeAsync()
    {
    }
}