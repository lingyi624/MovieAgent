@inject IMovieRepository MovieRepo

 <div class="filter-panel">
    <div class="filter-header">
        <h3>筛选条件</h3>
        <button @onclick="ResetFilters" class="reset-btn">重置</button>
    </div>

    <div class="filter-section">
        <h4>类型</h4>
        <div class="filter-tags">
            @foreach (var genre in Genres)
            {
                <button @onclick="() => ToggleGenre(genre)"
                        class="tag-btn @(SelectedGenres.Contains(genre) ? "selected" : "")">
                    @genre
                </button>
            }
        </div>
    </div>

    <div class="filter-section">
        <h4>年代</h4>
        <div class="year-range">
            <input type="number" @bind="MinYear" placeholder="起始年份" min="1900" max="2099" />
            <span class="separator">-</span>
            <input type="number" @bind="MaxYear" placeholder="结束年份" min="1900" max="2099" />
        </div>
    </div>

    <div class="filter-section">
        <h4>地区</h4>
        <div class="filter-tags">
            @foreach (var country in Countries)
            {
                <button @onclick="() => ToggleCountry(country)"
                        class="tag-btn @(SelectedCountries.Contains(country) ? "selected" : "")">
                    @country
                </button>
            }
        </div>
    </div>

    <div class="filter-section">
        <h4>语言</h4>
        <div class="filter-tags">
            @foreach (var language in Languages)
            {
                <button @onclick="() => ToggleLanguage(language)"
                        class="tag-btn @(SelectedLanguages.Contains(language) ? "selected" : "")">
                    @language
                </button>
            }
        </div>
    </div>

    <div class="filter-section">
        <h4>画质</h4>
        <div class="filter-tags">
            @foreach (var resolution in Resolutions)
            {
                <button @onclick="() => SelectResolution(resolution)"
                        class="tag-btn @(SelectedResolution == resolution ? "selected" : "")">
                    @resolution
                </button>
            }
        </div>
    </div>

    <div class="filter-section">
        <h4>HDR</h4>
        <div class="filter-tags">
            @foreach (var hdr in HdrTypes)
            {
                <button @onclick="() => SelectHdrType(hdr)"
                        class="tag-btn @(SelectedHdrType == hdr ? "selected" : "")">
                    @hdr
                </button>
            }
        </div>
    </div>

    <div class="filter-section">
        <h4>评分</h4>
        <div class="rating-range">
            <input type="range" @bind="MinRating" min="0" max="10" step="0.5" />
            <span>@MinRating - 10</span>
        </div>
    </div>

    <div class="filter-section">
        <h4>状态</h4>
        <div class="status-options">
            <label>
                <input type="checkbox" @bind="ShowWatched" />
                <span>已观看</span>
            </label>
            <label>
                <input type="checkbox" @bind="ShowUnwatched" />
                <span>未观看</span>
            </label>
            <label>
                <input type="checkbox" @bind="ShowFavorites" />
                <span>收藏</span>
            </label>
        </div>
    </div>

    <div class="filter-actions">
        <button @onclick="ApplyFilters" class="apply-btn">应用筛选</button>
    </div>
</div> 

