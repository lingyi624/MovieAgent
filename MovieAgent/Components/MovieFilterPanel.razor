@code {
    [Parameter]
    public EventCallback<MovieFilter> OnFilterChanged { get; set; }

    public List<string> Genres { get; set; } = new();
    public List<string> Countries { get; set; } = new();
    public List<string> Languages { get; set; } = new();
    public List<string> Resolutions { get; set; } = new();
    public List<string> HdrTypes { get; set; } = new();

    public List<string> SelectedGenres { get; set; } = new();
    public List<string> SelectedCountries { get; set; } = new();
    public List<string> SelectedLanguages { get; set; } = new();
    public string? SelectedResolution { get; set; }
    public string? SelectedHdrType { get; set; }
    public int? MinYear { get; set; }
    public int? MaxYear { get; set; }
    public double MinRating { get; set; } = 0;
    public bool ShowWatched { get; set; } = true;
    public bool ShowUnwatched { get; set; } = true;
    public bool ShowFavorites { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptions();
    }

    private async Task LoadFilterOptions()
    {
        Genres = await MovieRepo.GetAllGenresAsync();
        Countries = await MovieRepo.GetAllCountriesAsync();
        Languages = await MovieRepo.GetAllLanguagesAsync();
        Resolutions = await MovieRepo.GetAllResolutionsAsync();
        HdrTypes = await MovieRepo.GetAllHdrTypesAsync();
    }

    private async Task ToggleGenre(string genre)
    {
        if (SelectedGenres.Contains(genre))
            SelectedGenres.Remove(genre);
        else
            SelectedGenres.Add(genre);
        await Task.CompletedTask;
    }

    private async Task ToggleCountry(string country)
    {
        if (SelectedCountries.Contains(country))
            SelectedCountries.Remove(country);
        else
            SelectedCountries.Add(country);
        await Task.CompletedTask;
    }

    private async Task ToggleLanguage(string language)
    {
        if (SelectedLanguages.Contains(language))
            SelectedLanguages.Remove(language);
        else
            SelectedLanguages.Add(language);
        await Task.CompletedTask;
    }

    private async Task SelectResolution(string resolution)
    {
        SelectedResolution = SelectedResolution == resolution ? null : resolution;
        await Task.CompletedTask;
    }

    private async Task SelectHdrType(string hdr)
    {
        SelectedHdrType = SelectedHdrType == hdr ? null : hdr;
        await Task.CompletedTask;
    }

    private async Task ResetFilters()
    {
        SelectedGenres.Clear();
        SelectedCountries.Clear();
        SelectedLanguages.Clear();
        SelectedResolution = null;
        SelectedHdrType = null;
        MinYear = null;
        MaxYear = null;
        MinRating = 0;
        ShowWatched = true;
        ShowUnwatched = true;
        ShowFavorites = false;
        await Task.CompletedTask;
    }

    private async Task ApplyFilters()
    {
        var filter = new MovieFilter
        {
            Genres = SelectedGenres.Any() ? SelectedGenres : null,
            Countries = SelectedCountries.Any() ? SelectedCountries : null,
            Languages = SelectedLanguages.Any() ? SelectedLanguages : null,
            Resolution = SelectedResolution,
            HdrType = SelectedHdrType,
            MinYear = MinYear,
            MaxYear = MaxYear,
            MinRating = MinRating > 0 ? MinRating : null,
            IsWatched = !ShowWatched ? false : ShowWatched && !ShowUnwatched ? true : null,
            IsFavorite = ShowFavorites ? true : null
        };

        await OnFilterChanged.InvokeAsync(filter);
    }
}