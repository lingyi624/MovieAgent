@inject IThemeService ThemeService
@inject ILocalizationService LocalizationService

<MudIconButton 
    Icon="@(ThemeService.CurrentTheme == ThemeMode.Dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
    Color="Color.Inherit" 
    OnClick="ToggleTheme"
    title="@CurrentThemeName"
    Style="margin-left: 8px;" />

@code {
    private string CurrentThemeName => ThemeService.CurrentTheme == ThemeMode.Dark 
        ? LocalizationService.Translate("LightMode") 
        : LocalizationService.Translate("DarkMode");

    private async void ToggleTheme()
    {
        var newTheme = ThemeService.CurrentTheme == ThemeMode.Dark ? ThemeMode.Light : ThemeMode.Dark;
        await ThemeService.SetThemeAsync(newTheme);
    }
}