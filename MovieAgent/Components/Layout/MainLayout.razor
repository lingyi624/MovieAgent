@using MovieAgent.Components.Controls
@using MovieAgent.Core.Interfaces
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@inherits LayoutComponentBase
@inject IMovieRepository MovieRepo
@inject IAgentService AgentService
@inject IMovieScannerService ScannerService
@inject IThemeService ThemeService
@inject ILocalizationService LocalizationService
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
        <MudAppBar Elevation="2" Style="@AppBarStyle">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" />
            <img src="logo.svg" alt="MovieAgent Logo" style="width: 36px; height: 36px; margin-left: 8px;" />
            <MudText Typo="Typo.h6" Style="color: #E94560; font-weight: bold; margin-left: 8px;">
            Movie Agent(小雪雪)
            </MudText>
            <MudSpacer />
            <div style="flex: 1; display: flex; justify-content: center; max-width: 520px;">
                <SearchBar />
            </div>
            <MudSpacer />
            <MudButton Style="@ChatButtonStyle" Href="/chat" StartIcon="@Icons.Material.Filled.Message">
                @LocalizationService.Translate("Chat")
            </MudButton>
            <ThemeToggle />
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" OnClick="NavigateToSettings" />
        </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Variant="DrawerVariant.Temporary" Style="@DrawerStyle">
        <MudNavMenu>
            <MudText Typo="Typo.h6" Style="padding: 16px; color: #E94560;">@LocalizationService.Translate("Menu")</MudText>
            <MudDivider Style="background: #E94560;" />
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Home" OnClick="@(() => HandleNavClick("/"))">@LocalizationService.Translate("Home")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Movie" OnClick="@(() => HandleNavClick("/movies"))">@LocalizationService.Translate("Movies")</MudButton> 
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.BarChart" OnClick="@(() => HandleNavClick("/dashboard"))">@LocalizationService.Translate("Dashboard")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="@(() => HandleNavClick("/semantic-search"))">@LocalizationService.Translate("Search")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Chat" OnClick="@(() => HandleNavClick("/chat"))">@LocalizationService.Translate("Chat")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Report" OnClick="@(() => HandleNavClick("/report"))">@LocalizationService.Translate("Report")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Schedule" OnClick="@(() => HandleNavClick("/watch-plans"))">@LocalizationService.Translate("WatchPlans")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Label" OnClick="@(() => HandleNavClick("/tags"))">@LocalizationService.Translate("Tags")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => HandleNavClick("/downloads"))">下载管理</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.TextSnippet" OnClick="@(() => HandleNavClick("/logs"))">@LocalizationService.Translate("Logs")</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Settings" OnClick="@(() => HandleNavClick("/settings"))">@LocalizationService.Translate("Settings")</MudButton>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Style="@MainContentStyle">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private MudTheme _currentTheme = new MudTheme();
    private bool _isDark = true;

    protected override async Task OnInitializedAsync()
    {
        await ThemeService.LoadThemeAsync();
        _isDark = ThemeService.CurrentTheme == ThemeMode.Dark;
        UpdateTheme();
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged(ThemeMode theme)
    {
        _isDark = theme == ThemeMode.Dark;
        UpdateTheme();
        StateHasChanged();
    }

    private void UpdateTheme()
    {
        _currentTheme = _isDark ? CreateDarkTheme() : CreateLightTheme();
    }

    private MudTheme CreateDarkTheme() => new MudTheme
    {
        PaletteDark = new PaletteDark
        {
            Primary = Colors.Red.Accent3,
            Secondary = Colors.Green.Accent3,
            Background = "#0A0A14",
            Surface = "#0E0E1E",
            DrawerBackground = "#0E0E1E",
            DrawerText = "#E0E0E0",
            AppbarBackground = "#0E0E1E",
            AppbarText = "#E0E0E0",
            TextPrimary = "#E0E0E0",
            TextSecondary = "#888888",
            Error = Colors.Red.Accent3,
            Success = Colors.Green.Accent3,
            Info = Colors.Blue.Accent3,
            Warning = Colors.Orange.Accent3
        },
        PaletteLight = new PaletteLight
        {
            Primary = Colors.Red.Accent3,
            Secondary = Colors.Green.Accent3,
            Background = "#0A0A14",
            Surface = "#0E0E1E",
            DrawerBackground = "#0E0E1E",
            DrawerText = "#E0E0E0",
            AppbarBackground = "#0E0E1E",
            AppbarText = "#E0E0E0",
            TextPrimary = "#E0E0E0",
            TextSecondary = "#888888",
            Error = Colors.Red.Accent3,
            Success = Colors.Green.Accent3,
            Info = Colors.Blue.Accent3,
            Warning = Colors.Orange.Accent3
        }
    };

    private MudTheme CreateLightTheme() => new MudTheme
    {
        PaletteDark = new PaletteDark
        {
            Primary = Colors.Red.Accent3,
            Secondary = Colors.Green.Accent3,
            Background = "#FFFFFF",
            Surface = "#F5F5F5",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#333333",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#333333",
            TextPrimary = "#333333",
            TextSecondary = "#666666",
            Error = Colors.Red.Accent3,
            Success = Colors.Green.Accent3,
            Info = Colors.Blue.Accent3,
            Warning = Colors.Orange.Accent3
        },
        PaletteLight = new PaletteLight
        {
            Primary = Colors.Red.Accent3,
            Secondary = Colors.Green.Accent3,
            Background = "#FFFFFF",
            Surface = "#F5F5F5",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#333333",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#333333",
            TextPrimary = "#333333",
            TextSecondary = "#666666",
            Error = Colors.Red.Accent3,
            Success = Colors.Green.Accent3,
            Info = Colors.Blue.Accent3,
            Warning = Colors.Orange.Accent3
        }
    };

    private string AppBarStyle => _isDark 
        ? "background: linear-gradient(135deg, #0A0A14 0%, #141428 100%); border-bottom: 1px solid rgba(233,69,96,0.15);" 
        : "background: linear-gradient(135deg, #FFFFFF 0%, #F5F5F5 100%);";

    private string DrawerStyle => _isDark 
        ? "background: #0E0E1E; color: white;" 
        : "background: #FFFFFF; color: #333;";

    private string MainContentStyle => _isDark 
        ? "padding: 24px; min-height: calc(100vh - 64px); background: #0A0A14;" 
        : "padding: 24px; min-height: calc(100vh - 64px); background: #F5F5F5;";

    private string ChatButtonStyle => _isDark 
        ? "margin-right: 8px; color: white;" 
        : "margin-right: 8px; color: #333;";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void NavigateToSettings() => NavigationManager.NavigateTo("/settings");

    private void HandleNavClick(string url)
    {
        _drawerOpen = false;
        NavigationManager.NavigateTo(url, forceLoad: true);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
    }
}