@using MovieAgent.Components.Controls
@using MovieAgent.Core.Interfaces
@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase
@inject IMovieRepository MovieRepo
@inject IAgentService AgentService
@inject IMovieScannerService ScannerService
@inject IThemeService ThemeService
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
        <MudAppBar Elevation="2" Style="@AppBarStyle">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" />
            <img src="logo.svg" alt="MovieAgent Logo" style="width: 36px; height: 36px; margin-left: 8px;" />
            <MudText Typo="Typo.h6" Style="color: #E94560; font-weight: bold; margin-left: 8px;">
                Movie Agent
            </MudText>
            <MudSpacer />
            <SearchBar />
            <MudButton Style="margin-right: 8px; color: white;" Href="/chat" StartIcon="@Icons.Material.Filled.Message">
                AI 对话
            </MudButton>
            <ThemeToggle />
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" OnClick="NavigateToSettings" />
        </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Variant="DrawerVariant.Temporary" Style="background: #1A1A2E; color: white;">
        <MudNavMenu>
            <MudText Typo="Typo.h6" Style="padding: 16px; color: #E94560;">菜单</MudText>
            <MudDivider Style="background: #E94560;" />
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Home" OnClick="@(() => HandleNavClick("/"))">首页(海报墙)</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.BarChart" OnClick="@(() => HandleNavClick("/dashboard"))">观影统计</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Movie" OnClick="@(() => HandleNavClick("/movies"))">电影库</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="@(() => HandleNavClick("/semantic-search"))">语义搜索</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Chat" OnClick="@(() => HandleNavClick("/chat"))">AI 对话</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Report" OnClick="@(() => HandleNavClick("/report"))">观影报告</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Schedule" OnClick="@(() => HandleNavClick("/watch-plans"))">观影计划</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Label" OnClick="@(() => HandleNavClick("/tags"))">标签管理</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.TextSnippet" OnClick="@(() => HandleNavClick("/logs"))">系统日志</MudButton>
            <MudButton Class="nav-link-btn" StartIcon="@Icons.Material.Filled.Settings" OnClick="@(() => HandleNavClick("/settings"))">设置</MudButton>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Style="padding: 24px; min-height: calc(100vh - 64px);">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private MudTheme _currentTheme = new MudTheme();
    private bool _isDark = true;

    protected override async Task OnInitializedAsync()
    {
        await ThemeService.LoadThemeAsync();
        _isDark = ThemeService.CurrentTheme == ThemeMode.Dark;
        UpdateTheme();
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged(ThemeMode theme)
    {
        _isDark = theme == ThemeMode.Dark;
        UpdateTheme();
        StateHasChanged();
    }

    private void UpdateTheme()
    {
        _currentTheme = _isDark ? CreateDarkTheme() : CreateLightTheme();
    }

    private MudTheme CreateDarkTheme() => new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = Colors.Red.Accent3,
            Secondary = Colors.Green.Accent3,
            Background = "#0F0F1A",
            Surface = "#1A1A2E",
            DrawerBackground = "#1A1A2E",
            DrawerText = "#E0E0E0",
            AppbarBackground = "#1A1A2E",
            AppbarText = "#E0E0E0",
            TextPrimary = "#E0E0E0",
            TextSecondary = "#888888",
            Error = Colors.Red.Accent3,
            Success = Colors.Green.Accent3,
            Info = Colors.Blue.Accent3,
            Warning = Colors.Orange.Accent3
        }
    };

    private MudTheme CreateLightTheme() => new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = Colors.Red.Accent3,
            Secondary = Colors.Green.Accent3,
            Background = "#FFFFFF",
            Surface = "#F5F5F5",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#333333",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#333333",
            TextPrimary = "#333333",
            TextSecondary = "#666666",
            Error = Colors.Red.Accent3,
            Success = Colors.Green.Accent3,
            Info = Colors.Blue.Accent3,
            Warning = Colors.Orange.Accent3
        }
    };

    private string AppBarStyle => _isDark 
        ? "background: linear-gradient(135deg, #1A1A2E 0%, #16213E 100%);" 
        : "background: white;";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void NavigateToSettings() => NavigationManager.NavigateTo("/settings");

    private void HandleNavClick(string url)
    {
        _drawerOpen = false;
        NavigationManager.NavigateTo(url, forceLoad: true);
    }
}