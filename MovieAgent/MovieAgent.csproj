<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MovieAgent</RootNamespace>
    <ApplicationTitle>Movie Agent</ApplicationTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\appicon.ico</ApplicationIcon>
    <StartupObject>MovieAgent.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
	  
 		  <EnableDpiAwareness>true</EnableDpiAwareness>
		  <DpiAwareness>PerMonitorV2</DpiAwareness>
   </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.0-preview.3.25171.1" />
	  <PackageReference Include="MudBlazor" Version="9.5.0" />
	  <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0-preview.3.25171.1" />
	  <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" />
	  <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
	  <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
	  <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
	  <PackageReference Include="System.Management" Version="8.0.0" />
	  <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
	  <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
	  <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
	  <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
	  <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MovieAgent.Core\MovieAgent.Core.csproj" />
    <ProjectReference Include="..\MovieAgent.Infrastructure\MovieAgent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controls\VideoAudioSync\AdaptiveSyncManager.cs" />
    <Compile Remove="Controls\VideoAudioSync\MLAdaptiveSync.cs" />
    <Compile Remove="Controls\VideoAudioSync\MultiStrategySyncEngine.cs" />
    <Compile Remove="Controls\VideoAudioSync\SmartPlayer.cs" />
    <Compile Remove="Controls\VideoAudioSync\SyncMonitor.cs" />
    <Compile Remove="Controls\VideoAudioSync\VideoAnalyzer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Controls\Window\D3D12Window\Assets\Common.hlsli" />
    <None Remove="Controls\Window\D3D12Window\Assets\Triangle.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Controls\Window\D3D12Window\Assets\Common.hlsli">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Controls\Window\D3D12Window\Assets\Triangle.hlsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="share.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controls\VideoAudioSync\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\Window\D3D11Window\ControlWindow.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\Window\D3D11Window\VideoWindow.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <Target Name="GenerateIcon" BeforeTargets="Build" Condition="!Exists('Resources\appicon.ico')">
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -File generate-icon.ps1" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>