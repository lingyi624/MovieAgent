<Window x:Class="MovieAgent.Controls.Window.D3D9Window.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MovieAgent.Controls.Window.D3D9Window"
        mc:Ignorable="d"   Width="1200" Height="720"
        Title="视频播放"   WindowStyle="None" AllowsTransparency="False" Background="#01000000"
        Loaded="Window_Loaded" Closed="Window_Closed" MouseMove="Window_MouseMove"     KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Track x:Name="PART_Track" Grid.Column="1" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Height="3" Fill="#E94560" 
                                                   RadiusX="1.5" RadiusY="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Height="3" Fill="#555555" 
                                                   RadiusX="1.5" RadiusY="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#E94560" 
                                                 Stroke="#FFFFFF" 
                                                 StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="#E94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ControlButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#3D3D5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="ListButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="SelectedListButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#E94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" >
        
        <controls:D3D9VideoRenderer Grid.Row="1" x:Name="VideoRenderer"/>
        <!--<controls:D3D9ZeroCopyVideoRenderer x:Name="VideoRenderer"/>-->
        <!--<controls:D3DImageVideoRenderer  x:Name="VideoRenderer"/>-->


        <!--<Border Background="Transparent" IsHitTestVisible="False" />-->

        <TextBlock x:Name="SubtitleTextBlock" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="40,80"
                   Foreground="White"
                   FontSize="24"
                   FontFamily="Microsoft YaHei"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Padding="15,10"
                   Background="Transparent"
                   Visibility="Collapsed"
                   MaxWidth="800" />

        <Popup x:Name="ControlsPopup" StaysOpen="True" Placement="Center"  
               AllowsTransparency="True" PopupAnimation="Fade">
            <Grid x:Name="ControlsPopupGrid"  >
                <Border x:Name="TopBar" Panel.ZIndex="1" Background="#E6000000" VerticalAlignment="Top" Padding="10" Margin="20" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10,5">
                            <TextBlock x:Name="MovieTitle" Foreground="White" FontSize="16" 
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="电影标题"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,5">
                            <TextBlock x:Name="PlayStatusText" Foreground="#FFE94560" FontSize="14" 
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" | " Foreground="#555" Margin="8,0"/>
                            <TextBlock x:Name="AudioInfo" Foreground="#FFD0D0D0" FontSize="13" 
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" | " Foreground="#555" Margin="8,0"/>
                            <TextBlock x:Name="VideoInfo" Foreground="#FFD0D0D0" FontSize="13" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="DecodeModeInfo" Foreground="#FFE94560" FontSize="13" 
                                           FontWeight="Bold" VerticalAlignment="Center" ToolTip="当前解码方式"/>
                            </StackPanel>
                            <Button x:Name="CloseButton" Content="✕" Foreground="White" Background="Transparent" 
                                    Width="30" Height="30" FontSize="16" Click="CloseButton_Click" Margin="10,0,0,0"
                                      />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="BottomBar"  Panel.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                        Background="#E6000000">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="30,10,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Foreground="White" FontSize="13" 
                                       VerticalAlignment="Center" Width="55" Text="00:00"/>
                            <Slider x:Name="ProgressSlider" 
                                    Grid.Column="1" Height="24" Margin="15,0"   
                                    Style="{StaticResource CircleSliderStyle}"
                                    Foreground="#E94560" 
                                    Background="Transparent" 
                                    BorderBrush="Transparent"
                                    ValueChanged="ProgressSlider_ValueChanged"
                                    PreviewMouseLeftButtonUp="ProgressSlider_MouseUp"
                                    IsMoveToPointEnabled="True"
                                    LargeChange="5000" SmallChange="1000"
                                    TickPlacement="None"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalTimeText" Grid.Column="2" Foreground="White" FontSize="13" 
                                       VerticalAlignment="Center" Width="55" TextAlignment="Right" Text="00:00"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" 
                                    VerticalAlignment="Center" Margin="0,8,0,30">
                            <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" 
                                    Style="{StaticResource ControlButtonStyle}" ToolTip="停止播放"/>
                            <Border Width="1" Background="#555" Margin="10,5"/>
                            <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPauseButton_Click" 
                                    Style="{StaticResource PlayButtonStyle}" FontFamily="Segoe UI Symbol"
                                    ToolTip="播放/暂停"/>
                            <Border Width="1" Background="#555" Margin="10,5"/>
                            <TextBlock Text="🔊" FontSize="16" VerticalAlignment="Center" Foreground="White"/>
                            <Slider x:Name="VolumeSlider" Width="80" Height="24" Margin="8,0" 
                                    Foreground="#E94560" Background="Transparent" BorderBrush="Transparent"
                                    Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    IsMoveToPointEnabled="True"
                                    LargeChange="10" SmallChange="5"
                                    TickPlacement="None"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="VolumeLabel" Foreground="White" FontSize="13" 
                                       Width="30" VerticalAlignment="Center" Text="100"/>
                            <Border Width="1" Background="#555" Margin="15,5"/>
                            <Button x:Name="AudioButton" Content="🎵 音效" Click="AudioButton_Click" 
                                    Style="{StaticResource ControlButtonStyle}" ToolTip="切换音频轨道"/>
                            <Button x:Name="SubtitleButton" Content="📝 字幕" Click="SubtitleButton_Click" 
                                    Style="{StaticResource ControlButtonStyle}" ToolTip="字幕选项"/>
                            <Button x:Name="ScreenshotButton" Content="📷 截图" Click="ScreenshotButton_Click" 
                                    Style="{StaticResource ControlButtonStyle}" ToolTip="保存当前画面截图"/>
                            <Button x:Name="SpeedButton" Content="⚡ 速度" Click="SpeedButton_Click" 
                                    Style="{StaticResource ControlButtonStyle}" ToolTip="调整播放速度"/>
                            <Border Width="1" Background="#555" Margin="15,5"/>
                            <Button x:Name="InfoButton" Content="📊 信息" Click="InfoButton_Click" 
                                    Style="{StaticResource ControlButtonStyle}" ToolTip="显示系统配置和媒体信息"/>
                            <Border Width="1" Background="#555" Margin="15,5"/>
                            <Button x:Name="FullscreenButton" Content="⛶" Click="FullscreenButton_Click" 
                                    Style="{StaticResource ControlButtonStyle}" FontFamily="Segoe UI Symbol"
                                    ToolTip="全屏/退出全屏"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="CenterOverlay"   Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"
                         >
                    <Button x:Name="CenterPlayButton" Content="▶" Foreground="White" Background="Transparent" 
                            Width="80" Height="80" FontSize="40" Click="CenterPlayButton_Click"
                            Style="{x:Null}"/>
                </Border>
            </Grid>
        </Popup>

        <Popup x:Name="AudioPopup" StaysOpen="False" Placement="Top" 
               PlacementTarget="{Binding ElementName=AudioButton}"
               AllowsTransparency="True" PopupAnimation="Fade" Panel.ZIndex="200">
            <Border Background="#E6000000" BorderBrush="#555" BorderThickness="1" HorizontalAlignment="Stretch"
                    CornerRadius="8" Padding="5" MinWidth="250">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="选择音频轨道" Foreground="White" FontSize="14" 
                               FontWeight="Bold" Margin="10,8"/>
                    <Separator Background="#555" Margin="5,0"/>
                    <StackPanel x:Name="AudioTrackListPanel" HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="NoAudioTracksText" Text="未检测到音频轨道" 
                               Foreground="Gray" FontSize="12" Margin="10,8" 
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="SpeedPopup" StaysOpen="False" Placement="Top"
               PlacementTarget="{Binding ElementName=SpeedButton}"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#E6000000" BorderBrush="#555" BorderThickness="1" 
                    CornerRadius="8" Padding="5" MinWidth="180">
                <StackPanel>
                    <TextBlock Text="播放速度" Foreground="White" FontSize="14" 
                               FontWeight="Bold" Margin="10,8"/>
                    <Separator Background="#555" Margin="5,0"/>
                    <Button Content="0.5x" Click="SpeedOption_Click" Tag="0.5" Style="{StaticResource ListButtonStyle}"/>
                    <Button Content="0.75x" Click="SpeedOption_Click" Tag="0.75" Style="{StaticResource ListButtonStyle}"/>
                    <Button Content="1.0x (正常)" Click="SpeedOption_Click" Tag="1.0" Style="{StaticResource ListButtonStyle}"
                            Background="#E94560"/>
                    <Button Content="1.25x" Click="SpeedOption_Click" Tag="1.25" Style="{StaticResource ListButtonStyle}"/>
                    <Button Content="1.5x" Click="SpeedOption_Click" Tag="1.5" Style="{StaticResource ListButtonStyle}"/>
                    <Button Content="2.0x" Click="SpeedOption_Click" Tag="2.0" Style="{StaticResource ListButtonStyle}"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="SubtitlePopup" StaysOpen="False" Placement="Top"
               PlacementTarget="{Binding ElementName=SubtitleButton}"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#E6000000" BorderBrush="#555" BorderThickness="1" 
                    CornerRadius="8" Padding="5" MinWidth="250">
                <StackPanel>
                    <TextBlock Text="字幕选项" Foreground="White" FontSize="14" 
                               FontWeight="Bold" Margin="10,8"/>
                    <Separator Background="#555" Margin="5,0"/>
                    <TextBlock Text="内嵌字幕" Foreground="#AAA" FontSize="12" Margin="10,8,10,4"/>
                    <StackPanel x:Name="SubtitleTrackListPanel" HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="NoSubtitleTracksText" Text="无内嵌字幕" 
                               Foreground="Gray" FontSize="12" Margin="10,8" 
                               Visibility="Collapsed"/>
                    <Separator Background="#555" Margin="5,8"/>
                    <TextBlock Text="外部字幕" Foreground="#AAA" FontSize="12" Margin="10,4,10,8"/>
                    <Button x:Name="LoadSubtitleButton" Content="📂 加载字幕文件..." 
                            Style="{StaticResource ListButtonStyle}"
                            Click="LoadSubtitleButton_Click"/>
                    <Button x:Name="DownloadSubtitleButton" Content="⬇️ 下载字幕" 
                            Style="{StaticResource ListButtonStyle}"
                            Click="DownloadSubtitleButton_Click"/>
                    <Button x:Name="UnloadSubtitleButton" Content="❌ 卸载字幕" 
                            Style="{StaticResource ListButtonStyle}"
                            Click="UnloadSubtitleButton_Click"
                            Visibility="Collapsed"/>
                    <Separator Background="#555" Margin="5,8"/>
                    <TextBlock Text="字幕同步" Foreground="#AAA" FontSize="12" Margin="10,4,10,4"/>
                    <StackPanel Orientation="Horizontal" Margin="10,4,10,8">
                        <Button Content="◀◀ -1s" Click="SubtitleDelayButton_Click" Tag="-1000" 
                                Style="{StaticResource ControlButtonStyle}" Width="70" Height="28" FontSize="11"/>
                        <Button Content="◀ -0.5s" Click="SubtitleDelayButton_Click" Tag="-500" 
                                Style="{StaticResource ControlButtonStyle}" Width="70" Height="28" FontSize="11"/>
                        <Button Content="重置" Click="SubtitleDelayButton_Click" Tag="0" 
                                Style="{StaticResource ControlButtonStyle}" Width="55" Height="28" FontSize="11"
                                Background="#E94560"/>
                        <Button Content="+0.5s ▶" Click="SubtitleDelayButton_Click" Tag="500" 
                                Style="{StaticResource ControlButtonStyle}" Width="70" Height="28" FontSize="11"/>
                        <Button Content="+1s ▶▶" Click="SubtitleDelayButton_Click" Tag="1000" 
                                Style="{StaticResource ControlButtonStyle}" Width="70" Height="28" FontSize="11"/>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleDelayText" Text="延迟: 0ms" 
                               Foreground="#888" FontSize="11" Margin="10,0,10,8"/>
                    <TextBlock x:Name="CurrentSubtitleText" Text="" 
                               Foreground="#888" FontSize="11" Margin="12,4,10,8"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="InfoPopup" StaysOpen="False" Placement="Top"
               PlacementTarget="{Binding ElementName=InfoButton}"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#E6000000" BorderBrush="#555" BorderThickness="1" 
                    CornerRadius="8" Padding="10" MinWidth="500" MaxWidth="600">
                <StackPanel MaxHeight="500">
                    <TextBlock Text="系统配置与媒体信息" Foreground="White" FontSize="16" 
                               FontWeight="Bold" Margin="10,10,10,5"/>
                    <Separator Background="#555" Margin="5,0"/>
                    <TextBlock Text="📱 系统配置" Foreground="#E94560" FontSize="14" 
                               FontWeight="Bold" Margin="10,12,10,5"/>
                    <StackPanel x:Name="SystemInfoPanel" Margin="15,5,10,5">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="CPU:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="CpuInfoText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="内存:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="MemoryInfoText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="显卡:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="GpuInfoText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="分辨率:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="ResolutionText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="操作系统:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="OSInfoText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#555" Margin="5,10"/>
                    <TextBlock Text="🎬 媒体信息" Foreground="#E94560" FontSize="14" 
                               FontWeight="Bold" Margin="10,12,10,5"/>
                    <StackPanel x:Name="MediaInfoPanel" Margin="15,5,10,5">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="文件名:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="FileNameText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="分辨率:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="VideoResolutionText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="帧率:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="FpsText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="时长:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="DurationText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="解码方式:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="DecodeModeText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="解码器:" Foreground="#AAA" FontSize="12" Width="80"/>
                            <TextBlock x:Name="DecoderNameText" Foreground="White" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#555" Margin="5,10"/>
                    <Button x:Name="CloseInfoButton" Content="关闭" Click="CloseInfoButton_Click" 
                            Style="{StaticResource ControlButtonStyle}" 
                            HorizontalAlignment="Right" Margin="0,10,5,10"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="SubtitleDownloadPopup" StaysOpen="False" Placement="Center"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#E6000000" BorderBrush="#E94560" BorderThickness="1" 
                    CornerRadius="12" Padding="15" Width="500" Height="450">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,5,0,10">
                        <TextBlock Text="⬇️ 字幕下载" Foreground="White" FontSize="16" 
                                   FontWeight="Bold" Margin="10,0"/>
                        <Button x:Name="CloseSubtitleDownloadButton" Content="✕" 
                                Style="{StaticResource ListButtonStyle}"
                                Click="CloseSubtitleDownloadButton_Click"
                                HorizontalAlignment="Right" Width="30" Height="30"
                                Padding="0"/>
                    </StackPanel>
                    <Separator Background="#555" Margin="5,0"/>
                    <StackPanel Margin="10,10,10,5">
                        <TextBox x:Name="SubtitleSearchBox" 
                                 Foreground="White" Background="#3D3D5C" BorderBrush="#555"
                                 Padding="10" Margin="0,5,0,5"/>
                        <TextBlock x:Name="SubtitleSearchHint" Text="输入电影名称搜索字幕..." 
                                   Foreground="#888" FontSize="12" 
                                   Margin="-220,5,0,5" IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <Button x:Name="SearchSubtitleButton" Content="🔍 搜索" 
                                    Style="{StaticResource ControlButtonStyle}"
                                    Click="SearchSubtitleButton_Click" Width="80"/>
                            <ComboBox x:Name="SubtitleLanguageCombo" Margin="10,0,0,0" Width="120"
                                      Foreground="Black" Background="#3D3D5C" BorderBrush="#555">
                                <ComboBoxItem Content="中文" Tag="zh"/>
                                <ComboBoxItem Content="英文" Tag="en"/>
                                <ComboBoxItem Content="中英双语" Tag="zh-en"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="SubtitleResultsScroll" Height="220" Margin="10,0">
                        <StackPanel x:Name="SubtitleResultsPanel"/>
                    </ScrollViewer>
                    <TextBlock x:Name="SubtitleSearchStatus" Text="" Foreground="#888" 
                               FontSize="12" Margin="10,5,10,5" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>