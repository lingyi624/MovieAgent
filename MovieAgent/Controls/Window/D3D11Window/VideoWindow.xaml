<Window x:Class="MovieAgent.D3D11Window.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MovieAgent.D3D11Window"  Width="1200" Height="800"   
        Title="FFmpeg D3D11VA Player"  WindowState="Maximized"
        >
    <!--<Grid>
        --><!-- 直接作为 Image 使用，支持所有 Image 的布局属性 -->
        <!--<controls:D3D12VideoRenderer x:Name="VideoView"
                                    Stretch="Fill" 
                                     />--><!--
    </Grid>-->
    <Grid>
        <!-- 视频渲染控件，自动填满 -->
        <controls:D3D11VideoRenderer x:Name="VideoView"/>

        <!-- 叠加的 UI 控件（空域问题见后） -->
        <Button Content="播放" Width="80" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                Click="Play_Click"/>
    </Grid>
</Window>