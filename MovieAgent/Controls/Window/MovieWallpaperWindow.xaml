<Window x:Class="MovieAgent.Controls.Window.MovieWallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="电影壁纸"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="72"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E94560" BlurRadius="20" ShadowDepth="5"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="InfoStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        
        <Style x:Key="DescStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="MaxWidth" Value="600"/>
        </Style>
        
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"/>
        </Storyboard>
        
        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>
    
    <Grid x:Name="MainGrid" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
            </EventTrigger>
        </Grid.Triggers>
        
        <Image x:Name="PosterImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="0.3"/>
                    <GradientStop Color="Transparent" Offset="0.7"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.4"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        
        <TextBlock Text="“小雪雪”电影管家超级智能体"
                   FontFamily="Arial Black" FontSize="48"
                   Foreground="White" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,40,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="#E94560" BlurRadius="15" ShadowDepth="3"/>
            </TextBlock.Effect>
        </TextBlock>
        
        <StackPanel x:Name="InfoPanel" Margin="60,0,0,120" VerticalAlignment="Bottom">
            <TextBlock x:Name="MovieTitle" Style="{StaticResource TitleStyle}"/>
            <TextBlock x:Name="MovieDirector" Style="{StaticResource InfoStyle}"/>
            <TextBlock x:Name="MovieReleaseDate" Style="{StaticResource InfoStyle}"/>
            <TextBlock x:Name="MovieOverview" Style="{StaticResource DescStyle}"/>
        </StackPanel>
        
        <Button x:Name="PrevButton" 
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Background="#E94560"
                Foreground="White"
                Width="60" Height="60"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="30,0,0,0"
                Click="PrevButton_Click"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#E94560" CornerRadius="30" 
                            >
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Border.RenderTransformOrigin>
                        <TextBlock Text="◀" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <Button x:Name="NextButton" 
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Background="#E94560"
                Foreground="White"
                Width="60" Height="60"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0,0,30,0"
                Click="NextButton_Click"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#E94560" CornerRadius="30"
                             >
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Border.RenderTransformOrigin>
                        <TextBlock Text="▶" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <Button x:Name="CloseButton"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Background="Transparent"
                Foreground="White"
                Width="40" Height="40"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,30,30,0"
                Click="CloseButton_Click"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Background" Value="#E94560"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✕" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <TextBlock x:Name="TipText" Text="点击任意位置关闭" 
                   Foreground="#666666" FontSize="14"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>
    </Grid>
</Window>