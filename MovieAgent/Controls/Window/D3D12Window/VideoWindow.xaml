<Window x:Class="MovieAgent.D3D12Window.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MovieAgent.D3D12Window"    
        Title="FFmpeg D3D11VA Player"   
        > 
    <Grid>
        <!-- 视频渲染控件，自动填满 -->
        <controls:D3D12VideoRenderer x:Name="VideoView"/>

        <!-- 叠加的 UI 控件（空域问题见后） -->
        <Button Content="播放" Width="80" Height="30" Background="Red"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                Click="Play_Click"/>
    </Grid>
</Window>