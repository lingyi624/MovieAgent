<Window x:Class="MovieAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="Movie Agent"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        StateChanged="Window_StateChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- === 品牌色系：黑红 === -->
        <Color x:Key="AccentRed">#E94560</Color>
        <Color x:Key="AccentRedDeep">#C11B3B</Color>
        <Color x:Key="SurfaceDark">#0A0A14</Color>
        <Color x:Key="SurfaceMid">#101020</Color>
        <Color x:Key="SurfaceLight">#16162A</Color>
        <Color x:Key="TextPrimary">#E0E0E0</Color>
        <Color x:Key="TextSecondary">#888888</Color>

        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="RedDeepBrush" Color="{StaticResource AccentRedDeep}"/>
        <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}"/>
        <SolidColorBrush x:Key="SurfaceMidBrush" Color="{StaticResource SurfaceMid}"/>
        <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>

        <!-- === 标题栏渐变（底部发光线） === -->
        <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0E0E1E" Offset="0.85"/>
            <GradientStop Color="#141428" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RedSeparatorGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E94560" Offset="0"/>
            <GradientStop Color="#E94560" Offset="0.15"/>
            <GradientStop Color="#E94560" Offset="0.85"/>
            <GradientStop Color="#00E94560" Offset="1"/>
        </LinearGradientBrush>

        <!-- === 窗口控制按钮样式（通用） === -->
        <Style x:Key="WinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WinButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BF0F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- === 外层容器：圆角 + 阴影 === -->
    <Border x:Name="OuterBorder"
            CornerRadius="8"
            Background="{StaticResource SurfaceDarkBrush}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ====== 标题栏 ====== -->
            <Grid x:Name="TitleBar" Grid.Row="0"
                  Background="{StaticResource TitleBarGradient}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + 品牌标识 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                    <!-- 音频频谱图标（WPF Canvas 手绘） -->
                    <Canvas Width="18" Height="18" Margin="0,0,8,0">
                        <Rectangle Width="3" Height="14" Canvas.Left="0"  Canvas.Top="2"
                                   Fill="{StaticResource RedBrush}" RadiusX="1" RadiusY="1"/>
                        <Rectangle Width="3" Height="9"  Canvas.Left="5"  Canvas.Top="5"
                                   Fill="{StaticResource RedBrush}" RadiusX="1" RadiusY="1"/>
                        <Rectangle Width="3" Height="18" Canvas.Left="10" Canvas.Top="0"
                                   Fill="{StaticResource RedBrush}" RadiusX="1" RadiusY="1"/>
                        <Rectangle Width="3" Height="6"  Canvas.Left="15" Canvas.Top="6"
                                   Fill="{StaticResource RedBrush}" RadiusX="1" RadiusY="1"/>
                    </Canvas>
                    <TextBlock Text="MOVIE" Foreground="{StaticResource RedBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text="AGENT" Foreground="#CCCCCC" FontSize="13" FontWeight="Light"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource WinButtonStyle}" Content="&#xE921;"
                            Click="MinimizeButton_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource WinButtonStyle}"
                            Content="&#xE922;" Click="MaxRestoreButton_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;"
                            Click="CloseButton_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- ====== 红色分割线（渐变） ====== -->
            <Border Grid.Row="1" Background="{StaticResource RedSeparatorGradient}"/>

            <!-- ====== 主内容区 ====== -->
            <Grid Grid.Row="2" x:Name="MainGrid">
                <!-- 内发光线（顶部微光） -->
                <Border Height="1" VerticalAlignment="Top"
                        Background="#15E94560" IsHitTestVisible="False" Panel.ZIndex="1"/>

                <blazor:BlazorWebView x:Name="BlazorWebView"
                                      HostPage="wwwroot/index.html"
                                      Visibility="Visible" Panel.ZIndex="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>