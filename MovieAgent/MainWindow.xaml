<Window x:Class="MovieAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:controls="clr-namespace:MovieAgent.Controls"
        Title="Movie Agent - 您的智能电影管家"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="700" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- 圆角按钮样式 -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Slider 圆角样式（自动应用到所有 Slider） -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- 轨道背景 -->
                            <Border x:Name="TrackBackground" 
                                Background="{TemplateBinding Background}"
                                Height="6" 
                                CornerRadius="3"
                                VerticalAlignment="Center"/>

                            <!-- 轨道前景（已滑动部分） -->
                            <Border x:Name="TrackForeground" 
                                Background="{TemplateBinding Foreground}"
                                Height="6" 
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>

                            <!-- 滑块 Thumb -->
                            <Thumb x:Name="Thumb" 
                               Width="12" Height="12" 
                               Cursor="Hand"
                               VerticalAlignment="Center">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Width="12" Height="12"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <blazor:BlazorWebView x:Name="BlazorWebView" HostPage="wwwroot/index.html" 
                              Visibility="Visible" Panel.ZIndex="0" />

        <!-- 视频播放层 - 覆盖在 BlazorWebView 上面 -->
        <Grid x:Name="VideoOverlay" Background="Black" Visibility="Collapsed" 
              Panel.ZIndex="100" MouseMove="VideoOverlay_MouseMove">
            
            <!-- 视频渲染控件 -->
            <controls:VideoRenderer x:Name="VideoRendererControl" 
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Stretch="Uniform" />

            <!-- 顶部信息栏 - 显示音频格式信息 -->
            <StackPanel x:Name="TopBar" Orientation="Horizontal" 
                        HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Margin="20" Background="#99000000" Visibility="Collapsed">
                <TextBlock x:Name="AudioInfo" Foreground="White" FontSize="14" 
                           Margin="15,10" VerticalAlignment="Center" />
                <TextBlock x:Name="VideoInfo" Foreground="#FFD0D0D0" FontSize="12" 
                           Margin="15,10" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 底部控制栏 -->
            <Grid x:Name="BottomBar" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                  Background="#99000000" Visibility="Collapsed" Height="Auto">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                    <Button x:Name="PlayButton" Content="播放" Click="PlayButton_Click"  Style="{StaticResource RoundedButtonStyle}"
                            Width="70" Height="32" Foreground="White" Background="#333" 
                            BorderBrush="Transparent" Margin="5" />
                    <Button x:Name="PauseButton" Content="暂停" Click="PauseButton_Click" 
                            Width="70" Height="32" Foreground="White" Background="#333"  Style="{StaticResource RoundedButtonStyle}"
                            BorderBrush="Transparent" Margin="5" />
                    <Slider x:Name="ProgressSlider" Width="500" Height="20" Margin="10,0"   
                            Foreground="#FF6B6B" Background="#555" BorderBrush="Transparent"
                            ValueChanged="ProgressSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="ProgressSlider_MouseUp"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="TimeDisplay" Foreground="White" FontSize="14"  
                               Width="160" TextAlignment="Center" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Width="80" Height="20" Margin="10,0" 
                            Foreground="#FF6B6B" Background="#555" BorderBrush="Transparent"
                            Minimum="0" Maximum="100" Value="100"
                            ValueChanged="VolumeSlider_ValueChanged"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="VolumeLabel" Foreground="White" FontSize="14" 
                               Width="40" VerticalAlignment="Center" Text="100" />
                    <Button x:Name="FullscreenButton" Content="退出全屏" Click="FullscreenButton_Click" 
                            Width="90" Height="32" Foreground="White" Background="#333"  Style="{StaticResource RoundedButtonStyle}"
                            BorderBrush="Transparent" Margin="5" />
                    <Button x:Name="StopButton" Content="关闭" Click="StopButton_Click" 
                            Width="70" Height="32" Foreground="White" Background="#CC3333" Style="{StaticResource RoundedButtonStyle}"
                            BorderBrush="Transparent" Margin="5" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
